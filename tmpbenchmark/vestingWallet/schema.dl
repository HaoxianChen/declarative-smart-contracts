// Transactions / derived releases
.decl recv_release()
.decl release()                  // tx trigger
.public recv_release

.decl releaseAmount(n: int)      // derived payout amount (per release call)
.decl *released(n: int)
.public released(0)

// State
.decl *beneficiary(p: address)
.decl *start(t:uint)
.decl *duration(t:uint)
.decl *funds(b: int)            // abstract total funds to vest (compile-only)

.decl constructor(s: uint, d:uint, b:address)

// Properties (preserve original)
.decl *earlyRelease(e: int)
.violation earlyRelease

.decl invalidTx()
.violation invalidTx

// Transaction placeholder rules
release() :- recv_release().

