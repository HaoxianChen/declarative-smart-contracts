// Initialization
hasWinner(false) :- constructor().
quorumSize(1) :- constructor().
winningProposal(0) :- constructor().

// Voting
voteUnit(p,1) :- vote(_,p).
votes(p,c) :- voteUnit(p,_), c = sum one: voteUnit(p,one).

// Finalize: materialize winner state (avoid derived incremental maintenance that can introduce ReadTuple)
wins(p, true) :- finalize(p), votes(p,c), quorumSize(q), c >= q.
hasWinner(true) :- finalize(p), votes(p,c), quorumSize(q), c >= q.
winningProposal(p) :- finalize(p), votes(p,c), quorumSize(q), c >= q.

voted(v,true) :- vote(v,_).

