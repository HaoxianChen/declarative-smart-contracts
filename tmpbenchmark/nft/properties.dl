////////////////////
// Transaction validity (no state reads; only param/self-consistency + msgSender/owner)
////////////////////

// mint: only contract owner; to != 0
invalidTx() :- recv_mint(_,_,_), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_mint(_,to,_), to==0.

// burn: only contract owner; from != 0
invalidTx() :- recv_burn(_,_,_,_), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_burn(_,from,_,_), from==0.

// transfer: from == msg.sender; to != 0; from != 0
invalidTx() :- recv_transfer(from,_,_,_,_), from==0.
invalidTx() :- recv_transfer(_,to,_,_,_), to==0.
invalidTx() :- recv_transfer(from,_,_,_,_), msgSender(s), from!=s.

// setApproval: owner == msg.sender; spender != 0
invalidTx() :- recv_setApproval(_,_,_,o,_,_), msgSender(s), o!=s.
invalidTx() :- recv_setApproval(_,spender,_,_,_,_), spender==0.

// setApprovalForAll: owner == msg.sender; operator !=0; owner!=operator
invalidTx() :- recv_setApprovalForAll(o,_,_,_), msgSender(s), o!=s.
invalidTx() :- recv_setApprovalForAll(_,op,_,_), op==0.
invalidTx() :- recv_setApprovalForAll(o,op,_,_), o==op.

// transferFrom: operator == msg.sender; to != 0; from != 0
invalidTx() :- recv_transferFrom(from,_,_,_,_,_), from==0.
invalidTx() :- recv_transferFrom(_,to,_,_,_,_), to==0.
invalidTx() :- recv_transferFrom(_,_,_,op,_,_), msgSender(s), op!=s.

