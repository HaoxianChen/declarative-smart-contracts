// Views / state
.decl shares(p: address, n: uint)[0]
.decl released(p: address, n:uint)[0]

.decl *totalShares(n: uint)
.decl *totalReleased(n: uint)
.decl *totalReceived(n: uint)

// Constructor (needed by synthesis pipeline to build initial trace + constructor function)
.decl constructor()

// A minimal constructor-anchored singleton so the program references constructor()
.decl *initialized(b: bool)

// Expose a getter so the relation is materialized and constructor body is preserved in Solidity translation.
.public initialized(0)

// Interface + transaction
.decl recv_release(p: address)
.decl release(p: address)        // tx trigger
.public recv_release

// Derived tx amount (kept as a relation so we can sum over releases)
.decl releaseAmount(p: address, n: uint)[0]

// Properties (preserve original)
.decl overpaid(p: address, n: uint)[0]
.violation overpaid

.decl invalidTx()
.violation invalidTx

// Transaction placeholder rules
release(p) :- recv_release(p).

