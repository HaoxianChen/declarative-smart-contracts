// Preserve original property: released amount must not exceed proportional share
overpaid(p,e) :-
    totalReceived(r),
    shares(p,m),
    totalShares(s),
    released(p,e),
    s>0,
    e > r * m / s.

////////////////////
// Transaction validity
////////////////////

// release: p must be non-zero, shares defined, totalShares > 0
invalidTx() :- recv_release(p), p==0.
invalidTx() :- recv_release(p), shares(p,_), totalShares(s), s==0.

