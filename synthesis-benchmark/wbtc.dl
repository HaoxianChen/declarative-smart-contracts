// Adopted from: https://etherscan.io/token/0x2260fac5e5542a773aa44fbcfedf7c193bc2c599#code

// parameters
.decl *owner(p: address)

// views
.decl *totalSupply(n: int)
.decl balanceOf(p: address, n: int)[0]
.decl constructor()

// New views
.decl allowance(p: address, s: address, n:int)[0,1]

// Transactions
.decl mint(p: address, amount: int)
.decl recv_mint(p: address, amount: int)
.decl burn(p: address, amount: int)
.decl recv_burn(p: address, amount: int)
.decl transfer(s: address, r: address, n: int)
.decl recv_transfer(s: address, r: address, n: int)

// New transactions
.decl transferFrom(o: address, r: address, s: address, n: int)
.decl recv_transferFrom(o: address, r: address, s: address, n: int)
.decl increaseApproval(p: address, s: address, n: int)
.decl decreaseApproval(p: address, s: address, n: int)
// .decl recv_approve(s: address, n:int)
.decl recv_increaseApproval(p: address, s: address, n: int)
.decl recv_decreaseApproval(p: address, s: address, n: int)
.public recv_increaseApproval
.public recv_decreaseApproval

// Interfaces
.public recv_mint
.public recv_burn
.public recv_transfer
.public balanceOf(1)
.public totalSupply(0)

// New interfaces
// .public recv_approve
.public recv_transferFrom
.public allowance(2)

.decl *paused(b: bool)
.decl *pendingOwner(p: address)
// .decl *mintingFinished(b: bool)

.decl recv_pause()
.decl recv_unpause()
paused(true) :- recv_pause(). //msgSender(s), owner(s), paused(false).
paused(false) :- recv_unpause(). //msgSender(s), owner(s), paused(true).

.decl recv_transferOwnership(p:address)
.decl transferOwnership(p:address)
.decl recv_claimOwnership(p:address)
.decl claimOwnership(p:address)
transferOwnership(p) :- recv_transferOwnership(p). //, msgSender(s), owner(s), p!=0.
pendingOwner(p) :- transferOwnership(p).
claimOwnership(p) :- recv_claimOwnership(p). // msgSender(s), pendingOwner(s).
owner(s) :- claimOwnership(s).
pendingOwner(0) :- claimOwnership(_).

// .decl recv_reclaimToken()
// .decl reclaimToken(t:address, s:address,n: int)
// reclaimToken(t,s,n) :- recv_reclaimToken(), msgSender(s), owner(s),
//                     this(t), balanceOf(t,n).
// send(s,n) :- reclaimToken(_,s,n).
// transfer(t,s,n) :- reclaimToken(t,s,n).

.public recv_pause
.public recv_unpause
.public recv_transferOwnership
.public recv_claimOwnership
// .public recv_reclaimToken

// Rules
owner(s) :- constructor(), msgSender(s).
totalSupply(0) :- constructor().

mint(p,n) :- recv_mint(p,n). //msgSender(s), owner(s), p!=0.
burn(p,n) :- recv_burn(p,n). //msgSender(p), balanceOf(p,m), n<=m.
transfer(s,r,n) :- recv_transfer(s,r,n).
                  //  msgSender(s), balanceOf(s,m), n<=m,
                  // paused(false).

.decl totalMint(p: address, n: int)[0]
.decl totalBurn(p: address, n: int)[0]
.decl totalOut(p: address, n: int)[0]
.decl totalIn(p: address, n: int)[0]
totalOut(p,s) :- transfer(p,_,_), s = sum n: transfer(p,_,n).
totalIn(p,s) :- transfer(_,p,_), s = sum n: transfer(_,p,n).
totalMint(p,s) :- mint(p,_), s = sum n: mint(p,n).
totalBurn(p,s) :- burn(p,_), s = sum n: burn(p,n).
balanceOf(p,s) :- totalMint(p,n), totalBurn(p,m), totalOut(p,o), totalIn(p,i), s:=n+i-m-o.

.decl *allMint(n: int)
.decl *allBurn(n: int)
allMint(s) :- s = sum n: mint(_,n).
allBurn(s) :- s = sum n: burn(_,n).
totalSupply(n) :- allMint(m), allBurn(b), n := m - b.

// New rules
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n).
//                     balanceOf(o,m), m>=n,
//                     msgSender(s), allowance(o,s,k), k>=n,
//                     paused(false).
transfer(o,r,n) :- transferFrom(o,r,_,n).

// increaseAllowance(o,s,d) :- recv_approve(s,n), msgSender(o), allowance(o,s,m), d:=n-m.
increaseApproval(o, s, n) :- recv_increaseApproval(o, s, n).// , msgSender(o).
decreaseApproval(o, s, n) :- recv_decreaseApproval(o, s, n). //, msgSender(o), allowance(o,s,m), m>=n.

.decl allowanceTotal(o:address, s:address, m:int)[0,1]
.decl decreaseAllowanceTotal(o:address, s:address, m:int)[0,1]
.decl spentTotal(o:address, s:address, m:int)[0,1]
allowanceTotal(o,s,m) :- increaseApproval(o, s, _), m = sum n: increaseApproval(o, s, n).
decreaseAllowanceTotal(o,s,m) :- decreaseApproval(o, s, _), m = sum n: decreaseApproval(o, s, n).
spentTotal(o,s,m) :- transferFrom(o,_,s,_), m = sum n: transferFrom(o,_,s,n).

allowance(o,s,n) :- allowanceTotal(o,s,m), spentTotal(o,s,l), decreaseAllowanceTotal(o,s,d), n := m-l-d.

// Properties
// .decl *totalBalances(m: int)
// .decl *unequalBalance(s: int, n: int)
//
// .violation unequalBalance
//
// totalBalances(0) :- constructor().
// totalBalances(s) :- s = sum n: balanceOf(_,n).
// unequalBalance(s,n) :- totalBalances(s), totalSupply(n), s!=n.


.decl negativeBalance(p:address,n:int)[0]
.violation negativeBalance
negativeBalance(p,n) :- balanceOf(p,n), n<0, p!=0.

.decl negativeAllowance(s:address,p:address,n:int)[0,1]
.violation negativeAllowance
negativeAllowance(s,p,n) :- allowance(s,p,n), n<0, s!=0, p!=0.

.decl invalidTx()
.violation invalidTx
invalidTx() :- recv_mint(_,_), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_burn(_,_), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_pause(), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_pause(), paused(b), b==true.
invalidTx() :- recv_unpause(), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_unpause(), paused(b), b==false.
invalidTx() :- recv_transferOwnership(_), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_transferOwnership(p), p==0.
invalidTx() :- recv_claimOwnership(p), p==0.
invalidTx() :- recv_claimOwnership(s), pendingOwner(p), s==p.

