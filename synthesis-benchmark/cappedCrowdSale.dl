// parameters
.decl *owner(p: address)

// views
.decl *totalSupply(n: int)
.decl balanceOf(p: address, n: int)[0]
.decl constructor(c: int, r: int)

// New views
.decl allowance(p: address, s: address, n:int)[0,1]

// Transactions
.decl mint(p: address, amount: int)
.decl recv_mint(p: address, amount: int)
.decl burn(p: address, amount: int)
.decl recv_burn(p: address, amount: int)
.decl transfer(from: address, to: address, amount: int)
.decl recv_transfer(from: address, to: address, amount: int)

// New transactions
.decl recv_transferFrom(from: address, to: address, spender: address, amount: int)
.decl recv_increaseAllowance(o: address, s: address, n:int)
.decl increaseAllowance(o: address, s: address, n:int)
// .decl recv_approve(o: address, s: address, n:int)
// .decl approve(o: address, s:address, n:int)

// Interfaces
.public recv_mint
.public recv_burn
.public recv_transfer
.public balanceOf(1)
.public totalSupply(0)

// New interfaces
// .public recv_approve
.public recv_transferFrom
.public recv_increaseAllowance
.public allowance(2)

// Rules
owner(s) :- constructor(_,_), msgSender(s).
totalSupply(0) :- constructor(_,_).

// mint(p,n) :- recv_mint(p,n), msgSender(s), owner(o), s==o, p!=0.
// burn(p,n) :- recv_burn(p,n), msgSender(s), owner(o), s==o, p!=0 ,balanceOf(p,m), n<=m.
// transfer(s,r,n) :- recv_transfer(s,r,n), msgSender(s), balanceOf(s,m), n<=m.
mint(p,n) :- recv_mint(p,n).
burn(p,n) :- recv_burn(p,n).
transfer(s,r,n) :- recv_transfer(s,r,n).

.decl totalMint(p: address, n: int)[0]
.decl totalBurn(p: address, n: int)[0]
.decl totalOut(p: address, n: int)[0]
.decl totalIn(p: address, n: int)[0]
totalOut(p,s) :- transfer(p,_,_), s = sum n: transfer(p,_,n).
totalIn(p,s) :- transfer(_,p,_), s = sum n: transfer(_,p,n).
totalMint(p,s) :- mint(p,_), s = sum n: mint(p,n).
totalBurn(p,s) :- burn(p,_), s = sum n: burn(p,n).
balanceOf(p,s) :- totalMint(p,n), totalBurn(p,m), totalOut(p,o), totalIn(p,i), s:=n+i-m-o.

.decl *allMint(n: int)
.decl *allBurn(n: int)
allMint(s) :- s = sum n: mint(_,n).
allBurn(s) :- s = sum n: burn(_,n).
totalSupply(n) :- allMint(m), allBurn(b), n := m - b.

// New rules
.decl transferFrom(from: address, to: address, spender: address, amount: int)
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n).
//                     balanceOf(o,m), m>=n,
//                     msgSender(s), allowance(o,s,k), k>=n.
transfer(o,r,n) :- transferFrom(o,r,_,n).

// approve(o,s,d) :- recv_approve(o,s,n), msgSender(o).
// increaseAllowance(o,s,d) :- approve(o,s,n), msgSender(o), allowance(o,s,m), d:=n-m.
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d).

.decl allowanceTotal(o:address, s:address, m:int)[0,1]
.decl spentTotal(o:address, s:address, m:int)[0,1]
allowanceTotal(o,s,m) :- increaseAllowance(o,s,_), m = sum n: increaseAllowance(o,s,n).
spentTotal(o,s,m) :- transferFrom(o,_,s,_), m = sum n: transferFrom(o,_,s,n).

allowance(o,s,n) :- allowanceTotal(o,s,m), spentTotal(o,s,l), n := m-l.

///////////////////////////////////////////////////////////
.decl recv_finalize()
.public recv_finalize
.decl finalize()
.decl *finalized(b:bool)

// .decl *start(time: uint)
.decl *end(time: uint)

.public finalized(0)
// .public start(0)
// .public end(0)

.decl *rate(r: int)
.decl recv_buyToken(p:address, amount: int)
.decl buyToken(p:address, amount: int)
.public recv_buyToken

rate(r) :- constructor(_,r), r>0.
buyToken(p,m) :- recv_buyToken(p,m).
// finalized(f), f==false, p!=0, m!=0, now(t), start(s), end(e), t>s, t<e.
mint(p,n) :- buyToken(p,m), rate(r), n:=m*r.

.decl *raised(n: int)
raised(s) :- s = sum n: buyToken(_,n).
.decl *cap(n: int)
.public raised(0)
.public cap(0)

cap(c) :- constructor(c,_), c>0.
// finalize() :- recv_finalize(), msgSender(s), owner(o), s==o, finalized(f), f==false, now(t), end(e), t>e.
// finalize() :- recv_finalize(), msgSender(s), owner(o), s==o, finalized(f), f==false, raised(m), cap(c), m>=c.
finalize() :- recv_finalize().
finalized(true) :- finalize().


//property
.decl *onceFinalize(b:bool)
onceFinalize(false) :- constructor(_,_).
onceFinalize(true) :- finalize().

.decl illegalFinalization()
.violation illegalFinalization
// illegalFinalization() :- onceFinalize(true), now(t), end(e), t<e, raised(r), cap(c), r<c.
illegalFinalization() :- onceFinalize(true), raised(r), cap(c), r<c.

.decl buyAfterFinalize()
.violation buyAfterFinalize
buyAfterFinalize() :- recv_buyToken(_,_), onceFinalize(true). // transaction(recv_buyToken).

.decl negativeBalance(p:address,n:int)[0]
.violation negativeBalance
negativeBalance(p,n) :- balanceOf(p,n), n<0, p!=0.

.decl negativeAllowance(s:address,p:address,n:int)[0,1]
.violation negativeAllowance
negativeAllowance(s,p,n) :- allowance(s,p,n), n<0, s!=0, p!=0.

.decl invalidTx()
.violation invalidTx
invalidTx() :- recv_mint(_,_), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_burn(_,_), owner(o), msgSender(s), o!=s.