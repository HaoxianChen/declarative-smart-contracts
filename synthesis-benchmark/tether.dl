// Adopted from Etherscan: https://etherscan.io/token/0xdac17f958d2ee523a2206206994597c13d831ec7#code

// parameters
.decl *owner(p: address)

// views
.decl *totalSupply(n: int)
.decl balanceOf(p: address, n: int)[0]
.decl constructor(n: int)

// New views
.decl allowance(p: address, s: address, n:int)[0,1]
.decl isBlackListed(p: address, b:bool)[0]
.public isBlackListed(1)

// Fees
// .decl *rate(r: int)
// .decl *maxFee(m: int)
// .decl transferWithFee(from:address, to:address, fee:int, amount: int)
// .decl transferFromWithFee(from:address, to:address, spender:address, fee:int, amount: int)

// Transactions
.decl issue(p: address, amount: int)
.decl recv_issue(p: address, amount: int)
.decl redeem(p: address, amount: int)
.decl recv_redeem(p: address, amount: int)
.decl transfer(from: address, to: address, amount: int)
.decl recv_transfer(from: address,to: address, amount: int)

// New transactions
.decl recv_transferFrom(from: address, to: address, spender: address, amount: int)
.decl increaseAllowance(p: address, s: address, n:int)
.decl recv_increaseAllowance(p: address, s: address, n:int)
.public recv_increaseAllowance
// .decl recv_approve(s: address, n:int)

.decl destroyBlackFund(p:address,n:int)
.decl recv_destroyBlackFund(p:address, n:int)

destroyBlackFund(p,n) :- recv_destroyBlackFund(p,n).
//                          ,msgSender(s),owner(s),
//                         isBlackListed(p,true),
//                         balanceOf(p,n), p!=0, n>0.
redeem(p,n) :- destroyBlackFund(p,n).

// Interfaces
.public recv_issue
.public recv_redeem
.public recv_transfer
.public balanceOf(1)
.public totalSupply(0)

// New interfaces
// .public recv_approve
.public recv_transferFrom
.public allowance(2)

// Rules
owner(s) :- constructor(_), msgSender(s).
// totalSupply(n) :- constructor(n).
// balanceOf(s,n) :- constructor(n), msgSender(s).

issue(p,n) :- recv_issue(p,n). // msgSender(s), owner(s), p!=0.
redeem(p,n) :- recv_redeem(p,n). // msgSender(s), owner(s), p!=0 ,balanceOf(p,m), n<=m.

transfer(s,r,n) :- recv_transfer(s,r,n).
// transferWithFee(s,r,f,n) :- recv_transfer(s,r,n). msgSender(s), balanceOf(s,m), n<=m,
//                  isBlackListed(s,false),
//                 rate(rt), maxFee(mf),
//                 f := min(rt*n/10000, mf).

// transfer(s,r,m) :- transferWithFee(s,r,f,n), m := n-f.
// transfer(s,o,f) :- transferWithFee(s,r,f,_), owner(o).

.decl recv_addBlackList(p:address)
.decl addBlackList(p:address)
.public recv_addBlackList
addBlackList(p) :- recv_addBlackList(p). // msgSender(s),owner(s).
isBlackListed(p,true) :- addBlackList(p).

.decl totalIssue(p: address, n: int)[0]
.decl totalRedeem(p: address, n: int)[0]
.decl totalOut(p: address, n: int)[0]
.decl totalIn(p: address, n: int)[0]
totalOut(p,s) :- transfer(p,_,_), s = sum n: transfer(p,_,n).
totalIn(p,s) :- transfer(_,p,_), s = sum n: transfer(_,p,n).
totalIssue(p,s) :- issue(p,_), s = sum n: issue(p,n).
totalRedeem(p,s) :- redeem(p,_), s = sum n: redeem(p,n).
balanceOf(p,s) :- totalIssue(p,n), totalRedeem(p,m), totalOut(p,o), totalIn(p,i), s:=n+i-m-o.

.decl *allIssue(n: int)
.decl *allRedeem(n: int)
allIssue(s) :- s = sum n: issue(_,n).
allRedeem(s) :- s = sum n: redeem(_,n).
totalSupply(n) :- allIssue(m), allRedeem(b), n := m - b.

// New rules
.decl transferFrom(from: address, to: address, spender: address, amount: int)
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n).
// transferFromWithFee(o,r,s,f,n) :- recv_transferFrom(o,r,n),
//                     balanceOf(o,m), m>=n,
//                     msgSender(s), allowance(o,s,k), k>=n,
//                     isBlackListed(o,false),
//                     rate(rt), maxFee(mf),
//                     f := min(rt*n/10000, mf).
// transferFrom(o,r,s,m) :- transferFromWithFee(o,r,s,f,n), m := n-f.
// transferFrom(o,p,s,f) :- transferFromWithFee(o,r,s,f,_), owner(p).
transfer(o,r,n) :- transferFrom(o,r,_,n).

// increaseAllowance(o,s,d) :- recv_approve(s,n), msgSender(o), allowance(o,s,m), d:=n-m.
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d).

.decl allowanceTotal(o:address, s:address, m:int)[0,1]
.decl spentTotal(o:address, s:address, m:int)[0,1]
allowanceTotal(o,s,m) :- increaseAllowance(o,s,_), m = sum n: increaseAllowance(o,s,n).
spentTotal(o,s,m) :- transferFrom(o,_,s,_), m = sum n: transferFrom(o,_,s,n).

allowance(o,s,n) :- allowanceTotal(o,s,m), spentTotal(o,s,l), n := m-l.

// Properties
.decl *totalBalances(m: int)
.decl *unequalBalance(s: int, n: int)

.violation unequalBalance

// totalBalances(n) :- constructor(n).
totalBalances(s) :- s = sum n: balanceOf(_,n).
unequalBalance(s,n) :- totalBalances(s), totalSupply(n), s!=n.


.decl negativeBalance(p:address,n:int)[0]
.violation negativeBalance
negativeBalance(p,n) :- balanceOf(p,n), n<0, p!=0.

.decl negativeAllowance(s:address,p:address,n:int)[0,1]
.violation negativeAllowance
negativeAllowance(s,p,n) :- allowance(s,p,n), n<0, s!=0, p!=0.

.decl invalidTx()
.violation invalidTx
invalidTx() :- recv_addBlackList(_), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_issue(_,_), owner(o), msgSender(s), o!=s.
