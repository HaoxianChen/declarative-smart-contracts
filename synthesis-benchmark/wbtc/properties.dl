// no negative balances or allowances
negativeBalance(p,n) :- balanceOf(p,n), n<0, p!=0.
negativeAllowance(s,p,n) :- allowance(s,p,n), n<0, s!=0, p!=0.

// authority rules (retain recv_tx)
pauseNotByOwner() :- recv_pause(), owner(o), msgSender(s), s!=o.
pauseNotByOwner() :- recv_unpause(), owner(o), msgSender(s), s!=o.
transferOwnershipNotByOwner() :- recv_transferOwnership(_), owner(o), msgSender(s), s!=o.
claimOwnershipWrongCaller() :- recv_claimOwnership(p), pendingOwner(expected), p!=expected.
claimOwnershipWrongCaller() :- recv_claimOwnership(_), pendingOwner(expected), msgSender(s), s!=expected.

// authority rules
unauthorizedMint() :- recv_mint(_,_), owner(o), msgSender(s), s!=o.

