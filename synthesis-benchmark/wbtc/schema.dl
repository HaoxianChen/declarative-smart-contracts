// New views
.decl allowance(p: address, s: address, n:int)[0,1]

// Transactions
.decl mint(p: address, amount: int)
.decl recv_mint(p: address, amount: int)
.decl burn(p: address, amount: int)
.decl recv_burn(p: address, amount: int)
.decl transfer(s: address, r: address, n: int)
.decl recv_transfer(s: address, r: address, n: int)

// New transactions
.decl transferFrom(o: address, r: address, s: address, n: int)
.decl recv_transferFrom(o: address, r: address, s: address, n: int)
.decl increaseApproval(p: address, s: address, n: int)
.decl decreaseApproval(p: address, s: address, n: int)
