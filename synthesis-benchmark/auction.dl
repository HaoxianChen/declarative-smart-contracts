/**
  Example taken from Solidity documentation: https://docs.soliditylang.org/en/v0.8.7/solidity-by-example.html#simple-open-auction
 */

// Configs
.decl *owner(p: address)
.decl *beneficiary(p: address)
.decl *endTime(t: int)
.decl constructor(beneficiary: address, biddingTime: int)

// Constructor
owner(s) :- constructor(_,_), msgSender(s).
endTime(t2) :- constructor(_,d), now(t), t2 := t+d.
beneficiary(p) :- constructor(p,_).

// Transactions
.decl bid(bidder: address, amount: int)
.decl recv_bid(bidder: address, amount: int)
.decl withdraw(bidder: address)
.decl recv_withdraw(bidder: address)
.decl recv_withdrawWin(bidder: address)
.decl *end(b: bool)
.decl recv_endAuction()

// Interface
.public recv_bid
.public recv_withdraw
.public recv_withdrawWin
.public recv_endAuction

// Views
.decl *highestBid(bidder: address, amount: int)
.decl balance(p: address, n:int)[0]
.public balance(1)
.public highestBid(0)

highestBid(p,m) :- bid(p,m), m = max n: bid(_, n).

.decl withdrawTotal(p: address, n:int)[0]
.decl bidTotal(p: address, n:int)[0]
withdrawTotal(p,n) :- withdraw(p,_), n = sum m: withdraw(p,m).
bidTotal(p,n) :- bid(p, _), n = sum m: bid(p, m).
balance(p,n) :- bidTotal(p,b), withdrawTotal(p,w), n := b-w.

// Transaction conditions
// bid(p,n) :- recv_bid(), msgSender(p), msgValue(n), highestBid(_,m), n>m,
//            now(t1), endTime(t2), t1 < t2, end(false).
bid(p,n) :- recv_bid(p,n).

.decl withdrawCount(p:address, c:int)[0]
withdrawCount(p,c) :- withdraw(p), c = count: withdraw(p).

// withdraw(p,s) :- recv_withdraw(p,s), msgSender(p), highestBid(p,m), end(true), balance(p,n), n>m, s:=n-m.
// withdraw(p,n) :- recv_withdraw(p), msgSender(p), highestBid(h,_), p!=h, end(true), balance(p,n), n>0.
withdrawWin(p) :- recv_withdrawWin(p), msgSender(p), highestBid(p,m), end(true), balance(p,n), n>m.
withdraw(p) :- recv_withdraw(p), msgSender(p), highestBid(h,_), p!=h, end(true), balance(p,n), n>0.
send(p,n) :- withdrawWin(p), highestBid(p,m), s:=n-m.
send(p,n) :- withdraw(p), highestBid(h,_), balance(p,n).

end(true) :- recv_endAuction(), msgSender(s), owner(s), now(t1), endTime(t2), t1 >= t2, end(false).
// send(p,n) :- recv_endAuction(), msgSender(s), owner(s), now(t1), endTime(t2), t1 >= t2, highestBid(_,n), beneficiary(p), end(false).

// Property
.decl repeatWithdraw(p:address,c:int)[0]
.violation repeatWithdraw
repeatWithdraw(p,c) :- withdrawCount(p,c), c>1.

.decl negativeBalance(p:address,n:int)[0]
.violation negativeBalance
negativeBalance(p,n) :- balanceOf(p,n), n<0, p!=0.

.decl invalidTx()
.violation invalidTx
invalidTx() :- recv_withdraw(_), ended(b), b==false.
invalidTx() :- recv_withdrawWin(_), ended(b), b==false.

.decl insufficientBalance(p:address,n:int)[0]
.violation insufficientBalance
insufficientBalance(p,n) :- balance(p,n), highestBid(p,m), n<m.
