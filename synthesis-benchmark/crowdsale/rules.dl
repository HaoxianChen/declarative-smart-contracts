////////////////////
// Constructor rules
////////////////////
_finalized(false) :- constructor(_,_,_,_,_).
_primary(s) :- constructor(_,_,_,_,_), msgSender(s).
state(0) :- constructor(_,_,_,_,_).
_wallet(p) :- constructor(_,_,p,_,_).
_goal(a) :- constructor(_,_,_,n,a), a<=n.
_cap(n) :- constructor(_,_,_,n,a), a<=n.
totalSupply(0) :- constructor(_,_,_,_,_).
_openingTime(t1) :- constructor(t1,_,_,_,_).
_closingTime(t2) :- constructor(_,t2,_,_,_).
_beneficiary(p) :- _wallet(p).

// Direction A: give deployer an initial positive balance so synthesized guards like
// `balanceOf[p] > 0` don't deadlock all public transactions.
mint(s, 1) :- constructor(_,_,_,_,_), msgSender(s).

////////////////////
// ERC20 core
////////////////////
totalOut(p,s) :- transfer(p,_,_), s = sum n: transfer(p,_,n).
totalIn(p,s) :- transfer(_,p,_), s = sum n: transfer(_,p,n).
totalMint(p,s) :- mint(p,_), s = sum n: mint(p,n).
totalBurn(p,s) :- burn(p,_), s = sum n: burn(p,n).

balanceOf(p,s) :-
    totalMint(p,n),
    totalBurn(p,m),
    totalOut(p,o),
    totalIn(p,i),
    s := n+i-m-o.

allMint(s) :- s = sum n: mint(_,n).
allBurn(s) :- s = sum n: burn(_,n).
totalSupply(n) :- allMint(m), allBurn(b), n := m - b.

////////////////////
// Allowance
////////////////////
transfer(o,r,n) :- transferFrom(o,r,_,n).

allowanceTotal(o,s,m) :-
    increaseAllowance(o,s,_),
    m = sum n: increaseAllowance(o,s,n).

spentTotal(o,s,m) :-
    transferFrom(o,_,s,_),
    m = sum n: transferFrom(o,_,s,n).

allowance(o,s,n) :-
    allowanceTotal(o,s,m),
    spentTotal(o,s,l),
    n := m-l.

////////////////////
// RefundEscrow
////////////////////
_primary(p) :- transferPrimary(p).

_deposits(p,s) :- deposit(p,_), s = sum n: deposit(p,n).

_deposits(p,a) :- withdraw(p), a := 0.

////////////////////
// Crowdsale
////////////////////
// Token amount is calculated via the rate conversion UDF, matching _getTokenAmount in the original contract.
// Deposit remains in wei (ETH amount sent), which is what the escrow records.
mint(p,tokens) :- buyToken(p,v), getTokenAmount(v,tokens).
deposit(p,n) :- buyToken(p,n).

raised(a) :- buyToken(_,a).
_weiRaised(s) :- raised(_), s = sum n: raised(n).

////////////////////
// Finalization
////////////////////
_finalized(true) :- finalize().

finalization() :- finalize().

// Break the state-machine recursion by making state transitions depend only on finalize()
// (guards are enforced in properties.dl via invalidTx()).
state(2) :-
    finalize(),
    _goal(a),
    _weiRaised(n),
    n>=a.

state(1) :-
    finalize(),
    _goal(a),
    _weiRaised(n),
    n<a.

// Keep these as views for readability (no longer participate in state updates).
closeEscrow() :- state(2).
enableRefunds() :- state(1).