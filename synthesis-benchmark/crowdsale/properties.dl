// always (_weiRaised <= _cap)
moreThanCap(true) :-
    _weiRaised(n),
    _cap(m),
    n > m.

// wallet must equal beneficiary
notSame(true) :-
    _wallet(p),
    _beneficiary(p2),
    p != p2.

// authority rules (retain recv_tx)
transferPrimaryNotByPrimary() :- recv_transferPrimary(_), _primary(p), msgSender(s), s!=p.
finalizeNotByPrimary() :- recv_finalize(), _primary(p), msgSender(s), s!=p.

// lifecycle (once sentinel)
withdrawOutsideSuccessState() :- onceWithdrawOutsideSuccess(b), b==true.
claimRefundOutsideRefundState() :- onceClaimRefundOutsideRefund(b), b==true.
buyAfterFinalize() :- onceBuyAfterFinalize(b), b==true.
