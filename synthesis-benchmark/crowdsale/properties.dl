////////////////////
// Safety properties
////////////////////

// always (_weiRaised <= _cap)
moreThanCap(true) :-
    _weiRaised(n),
    _cap(m),
    n > m.

// wallet must equal beneficiary
notSame(true) :-
    _wallet(p),
    _beneficiary(p2),
    p != p2.


// Mint: receiver must be non-zero
invalidTx() :- recv_mint(p,_), p==0.

// Burn: receiver must be non-zero and amount must not exceed balance
invalidTx() :- recv_burn(p,_), p==0.
invalidTx() :- recv_burn(p,n), balanceOf(p,m), n>m.

// Transfer: amount must not exceed sender balance (and sender/receiver non-zero)
invalidTx() :- recv_transfer(s,r,_), s==0.
invalidTx() :- recv_transfer(s,r,_), r==0.
invalidTx() :- recv_transfer(s,_,n), balanceOf(s,m), n>m.

// TransferFrom: amount must not exceed owner balance and allowance
invalidTx() :- recv_transferFrom(o,_,_,_), o==0.
invalidTx() :- recv_transferFrom(_,r,_,_), r==0.
invalidTx() :- recv_transferFrom(o,_,sp,n), balanceOf(o,m), n>m.
invalidTx() :- recv_transferFrom(o,_,sp,n), allowance(o,sp,k), n>k.

// increaseAllowance: non-negative delta, and the explicit owner argument must match the caller
invalidTx() :- recv_increaseAllowance(_,_,n), n<0.
invalidTx() :- recv_increaseAllowance(o,_,_), msgSender(s), o!=s.

// Deposit: beneficiary must be non-zero and escrow must be in state 0
invalidTx() :- recv_deposit(p,_), p==0.
invalidTx() :- recv_deposit(_,a), a==0.
invalidTx() :- recv_deposit(_,_), state(h), h!=0.
invalidTx() :- recv_deposit(_,_), msgSender(s), _primary(p), s!=p.

// Withdraw: only primary can withdraw
invalidTx() :- recv_withdraw(_), msgSender(s), _primary(p), s!=p.

// TransferPrimary: non-zero recipient, only primary can transfer
invalidTx() :- recv_transferPrimary(p), p==0.
invalidTx() :- recv_transferPrimary(_), msgSender(s), _primary(p), s!=p.

// BuyToken: buyer non-zero, value non-zero, and raised should not exceed cap
invalidTx() :- recv_buyToken(p,_), p==0.
invalidTx() :- recv_buyToken(_,v), v==0.
invalidTx() :- recv_buyToken(_,_), _weiRaised(r), _cap(c), r>c.

// BuyToken: must be within [openingTime, closingTime] and before finalization/state transition
invalidTx() :- recv_buyToken(_,_), now(t), _openingTime(o), t<o.
invalidTx() :- recv_buyToken(_,_), now(t), _closingTime(c), t>c.
invalidTx() :- recv_buyToken(_,_), _finalized(b), b==true.
invalidTx() :- recv_buyToken(_,_), state(h), h!=0.

// Finalize: only primary; only once; only after closingTime; only when state==0
invalidTx() :- recv_finalize(), _finalized(b), b==true.
invalidTx() :- recv_finalize(), msgSender(s), _primary(p), s!=p.
invalidTx() :- recv_finalize(), state(h), h!=0.
invalidTx() :- recv_finalize(), now(t), _closingTime(c), t<c.

// ClaimRefund: only after finalization, only in refund state, only if goal not met, and must have deposits > 0
invalidTx() :- recv_claimRefund(_), _finalized(b), b==false.
invalidTx() :- recv_claimRefund(_), state(h), h!=1.
invalidTx() :- recv_claimRefund(_), _weiRaised(r), _goal(g), r>=g.
invalidTx() :- recv_claimRefund(p), _deposits(p,a), a==0.

// BuyToken: token amount computed by getTokenAmount must be positive.
// This mirrors the original contract requirement that _rate > 0 and weiAmount > 0
// so that _getTokenAmount(weiAmount) returns a non-zero token count.
invalidTx() :- recv_buyToken(_,v), getTokenAmount(v,tokens), tokens<=0.