// Initialization
owner(s) :- constructor(), msgSender(s).

// ===== ownerOf / exists：direct overwrite from recv_* (no joins, no reads) =====
ownerOf(tokenId, to) :- recv_mint(tokenId, to, _).
exists(tokenId, true) :- recv_mint(tokenId, _, _).

ownerOf(tokenId, 0) :- recv_burn(tokenId, _, _, _).
exists(tokenId, false) :- recv_burn(tokenId, _, _, _).

ownerOf(tokenId, to) :- recv_transfer(_, to, tokenId, _, _).
exists(tokenId, true) :- recv_transfer(_, _, tokenId, _, _).

ownerOf(tokenId, to) :- recv_transferFrom(_, to, tokenId, _, _, _).
exists(tokenId, true) :- recv_transferFrom(_, _, tokenId, _, _, _).

// ===== approvals：no state reads; clear old approval using prevApproved =====
approved(tokenId, prev, false) :-
  recv_setApproval(tokenId, _, _, _, prev, _),
  prev!=0.
approved(tokenId, spender, b) :-
  recv_setApproval(tokenId, spender, b, _, _, _).

approved(tokenId, prev, false) :- recv_burn(tokenId, _, prev, _), prev!=0.
approved(tokenId, prev, false) :- recv_transfer(_, _, tokenId, prev, _), prev!=0.
approved(tokenId, prev, false) :- recv_transferFrom(_, _, tokenId, _, prev, _), prev!=0.

isApprovedForAll(owner, op, b) :- recv_setApprovalForAll(owner, op, b, _).

// ===== balanceOf：delta + sum (no count/max; no joins) =====
deltaBal(to,  1) :- recv_mint(_, to, _), to!=0.

deltaBal(from,-1) :- recv_burn(_, from, _, _), from!=0.

deltaBal(from,-1) :- recv_transfer(from, _, _, _, _), from!=0.
deltaBal(to,  1)  :- recv_transfer(_, to, _, _, _), to!=0.

deltaBal(from,-1) :- recv_transferFrom(from, _, _, _, _, _), from!=0.
deltaBal(to,  1)  :- recv_transferFrom(_, to, _, _, _, _), to!=0.

balanceOf(p,n) :- n = sum d: deltaBal(p,d).

