// Parameters
.decl *owner(p: address)

// Views (materialized)
.decl ownerOf(tokenId: uint, p: address)[0]
.decl exists(tokenId: uint, b: bool)[0]
.decl approved(tokenId: uint, spender: address, b: bool)[0,1]
.decl isApprovedForAll(owner: address, operator: address, b: bool)[0,1]

// Balance via delta + sum (no count/max, no join)
.decl deltaBal(p: address, d: int)[0]
.decl balanceOf(p: address, n: int)[0]

.decl constructor()

// Interfaces (A1: no state reads; carry operator + prevApproved as needed)
.decl recv_mint(tokenId: uint, to: address, t: uint)

// prevApproved is used to clear token-level approval without reading state
.decl recv_burn(tokenId: uint, from: address, prevApproved: address, t: uint)

.decl recv_transfer(from: address, to: address, tokenId: uint, prevApproved: address, t: uint)

.decl recv_transferFrom(from: address, to: address, tokenId: uint, operator: address, prevApproved: address, t: uint)

.decl recv_setApproval(tokenId: uint, spender: address, b: bool, owner: address, prevApproved: address, t: uint)

.decl recv_setApprovalForAll(owner: address, operator: address, b: bool, t: uint)

// Interfaces
.public recv_mint
.public recv_burn
.public recv_transfer
.public recv_transferFrom
.public recv_setApproval
.public recv_setApprovalForAll

.public ownerOf(1)
.public exists(1)
.public balanceOf(1)
.public approved(2)
.public isApprovedForAll(2)

// UDF: ERC721 receiver hook (safeTransferFrom checks that recipient contracts accept the token)
.decl onERC721Received(to: address, tokenId: uint, success: bool)
.udf onERC721Received

// Properties
.decl invalidTx()
.violation invalidTx

