pragma solidity ^0.8.0;

// UDF implementations for the Theta token benchmark.
//
// canTransfer encodes the pre-circulation permission gate:
//   - After the unlock time has passed, all transfers are allowed.
//   - Before the unlock time, both sender and receiver must be
//     explicitly marked as pre-circulated (allowlist).
//
// State variables referenced here are generated by the synthesizer from
// the Datalog schema:
//   unlockTime  -> UnlockTimeTuple unlockTime   (field: .t)
//   precirculated -> mapping(address => PrecirculatedTuple) precirculated  (field: .b)

contract ThetaUDF {
    struct UnlockTimeTuple { uint t; bool _valid; }
    struct PrecirculatedTuple { bool b; bool _valid; }

    UnlockTimeTuple unlockTime;
    mapping(address => PrecirculatedTuple) precirculated;

    function canTransfer(address from, address to) external view returns (bool) {
        if (block.timestamp >= unlockTime.t) return true;
        return precirculated[from].b && precirculated[to].b;
    }
}
