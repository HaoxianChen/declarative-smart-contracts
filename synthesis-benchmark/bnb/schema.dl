// adopted from Etherscan: https://etherscan.io/token/0xB8c77482e45F1F44dE1745F52C74426C631bDD52#code.

// parameters
.decl *owner(p: address)

// views
.decl *totalSupply(n: int >= 0)
.decl balanceOf(p: address, n: int >= 0)[0]
.decl freezeOf(p: address, n: int >= 0)[0]
.decl constructor(n: int)

// New views
.decl allowance(p: address, s: address, n:int >= 0)[0,1]

// Transactions
.decl mint(p: address, amount: int)
.decl recv_mint(p: address <> 0, amount: int > 0)
.decl burn(p: address, amount: int)
.decl recv_burn(p: address, amount: int > 0)
.decl transfer(from: address, to: address, amount: int)
.decl recv_transfer(from: address <> 0, to: address <> 0, amount: int > 0)

// New transactions
.decl recv_transferFrom(from: address, to: address, spender: address, amount: int > 0)
.decl transferFrom(from: address, to: address, spender: address, amount: int)
.decl recv_increaseAllowance(o: address, s: address, n:int >= 0)
.decl increaseAllowance(o: address, s: address, n:int)

// Interfaces
.public recv_mint
.public recv_burn
.public recv_transfer
.public balanceOf(1)
.public totalSupply(0)

// New interfaces
.public recv_increaseAllowance
.public recv_transferFrom
.public allowance(2)

.decl recv_freeze(p: address, n: int > 0)
.decl recv_unfreeze(p: address, n: int > 0)
.decl freeze(p: address, n: int)
.decl unfreeze(p: address, n: int)

.decl recv_withdrawEther(p: address, amount: int > 0)
.decl withdrawEther(p:address, amount: int)

// UDF: native ETH transfer executed during withdrawEther (mirrors payable(owner).transfer(amount))
.decl sendEther(recipient: address, amount: int, success: bool)
.udf sendEther

.public recv_freeze
.public recv_unfreeze
.public recv_withdrawEther

.decl totalMint(p: address, n: int)[0]
.decl totalBurn(p: address, n: int)[0]
.decl totalFreeze(p: address, n: int)[0]
.decl totalUnfreeze(p: address, n: int)[0]
.decl totalOut(p: address, n: int)[0]
.decl totalIn(p: address, n: int)[0]

.decl *allMint(n: int)
.decl *allBurn(n: int)

.decl allowanceTotal(o:address, s:address, m:int)[0,1]
.decl spentTotal(o:address, s:address, m:int)[0,1]


// Properties
.decl *totalBalances(m: int)
.decl *freezeSum(m: int)
.decl *unequalBalance(s: int, n: int)

.violation unequalBalance


.decl negativeBalance(p:address,n:int)[0]
.violation negativeBalance

.decl negativeAllowance(s:address,p:address,n:int)[0,1]
.violation negativeAllowance

.decl unauthorizedMint()
.violation unauthorizedMint

.decl unauthorizedBurn()
.violation unauthorizedBurn

.decl unauthorizedWithdrawEther()
.violation unauthorizedWithdrawEther

.decl invalidTx()
.violation invalidTx

// Transaction placeholder rules
mint(p,n) :- recv_mint(p,n).
burn(p,n) :- recv_burn(p,n).
transfer(s,r,n) :- recv_transfer(s,r,n).
freeze(p,n) :- recv_freeze(p,n).
unfreeze(p,n) :- recv_unfreeze(p,n).
withdrawEther(p,n) :- recv_withdrawEther(p,n).
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n).
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d).
