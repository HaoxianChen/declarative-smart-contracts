////////////////////////////
// SheepFarm - high-fidelity model
//
// Covers the full economic loop:
//   register -> addGems -> upgradeVillage -> collectMoney -> withdrawMoney
//
// UDFs (pure lookup tables):
//   getYield(farm, sheep)        -> yield increment per hour
//   getUpgradePrice(farm, sheep) -> gem cost (price/denominator, denominator=10)
//   syncYield(user)              -> accrued wool (state-reading: yield * elapsed hours)
//
// Key fix: register() must only succeed once per address (timestamp guard).
////////////////////////////

.decl constructor()

// Core village state
.decl villageGems(user: address, n: int)[0]       // gem balance
.decl villageWool(user: address, n: int)[0]       // wool (money) balance
.decl villageYield(user: address, y: int)[0]      // cumulative hourly yield rate
.decl villageTimestamp(user: address, t: uint)[0] // last-sync block.timestamp
.decl villageNeighbor(user: address, ref: address)[0]

.decl *totalVillages(n: uint)
.decl *totalSheeps(n: uint)

// Intermediate accounting helpers
.decl gemIncome(user: address, n: int)        // all gem income events
.decl gemsEarned(user: address, n: int)[0]   // total gems earned
.decl gemsSpent(user: address, n: int)[0]    // total gems spent on upgrades
.decl woolEarned(user: address, n: int)[0]   // total wool collected
.decl woolSpent(user: address, n: int)[0]    // total wool withdrawn

// UDFs
.decl getYield(farm: uint, sheep: uint, y: int)
.udf getYield

.decl getUpgradePrice(farm: uint, sheep: uint, price: int)
.udf getUpgradePrice

// State-reading UDF: accrued wool = villageYield * elapsed_hours (capped at 24h)
.decl syncYield(user: address, wool: int)
.udf syncYield

// Transactions
.decl recv_register(ref: address)
.public recv_register
.decl register(user: address, ref: address, gems: int, t: uint)

.decl recv_addGems(gems: int)
.public recv_addGems
.decl addGems(user: address, gems: int)

.decl recv_upgradeVillage(farm: uint, sheep: uint)
.public recv_upgradeVillage
.decl upgradeVillage(user: address, farm: uint, sheep: uint, yDelta: int, cost: int)

.decl recv_collectMoney()
.public recv_collectMoney
.decl collectMoney(user: address, wool: int, t: uint)

.decl recv_withdrawMoney(amount: int)
.public recv_withdrawMoney
.decl withdrawMoney(user: address, amount: int)

// Public views
.public villageGems(1)
.public villageWool(1)
.public villageYield(1)
.public villageTimestamp(1)
.public villageNeighbor(1)
.public totalVillages(0)
.public totalSheeps(0)

// Properties
.decl invalidTx()
.violation invalidTx
.decl negativeGems(user: address, n: int)[0]
.violation negativeGems
.decl negativeWool(user: address, n: int)[0]
.violation negativeWool

// Transaction placeholder rules
register(user, ref, 10, t)       :- recv_register(ref), msgSender(user), now(t).
addGems(user, gems)              :- recv_addGems(gems), msgSender(user).
upgradeVillage(user, farm, sheep, y, c) :- recv_upgradeVillage(farm, sheep), msgSender(user), getYield(farm, sheep, y), getUpgradePrice(farm, sheep, c).
collectMoney(user, wool, t)      :- recv_collectMoney(), msgSender(user), syncYield(user, wool), now(t).
withdrawMoney(user, amount)      :- recv_withdrawMoney(amount), msgSender(user).
