////////////////////////////
// SheepFarm rules
//
// All state is derived from transaction history.
// Uses a unified gemIncome helper relation to avoid Datalog negation when
// computing balances across multiple income sources (register + addGems).
////////////////////////////

// Constructor initializes counters to zero
totalVillages(0) :- constructor().
totalSheeps(0)   :- constructor().

// Timestamp: set at register, refreshed at each collectMoney (mirrors syncVillage)
villageTimestamp(user, t) :- register(user, _, _, t).
villageTimestamp(user, t) :- collectMoney(user, _, t).

// Neighbor: recorded at registration
villageNeighbor(user, ref) :- register(user, ref, _, _).

// Counters
totalVillages(n) :- register(_, _, _, _), n = count: register(_, _, _, _).
totalSheeps(n)   :- upgradeVillage(_, _, _, _, _), n = count: upgradeVillage(_, _, _, _, _).

// Gem accounting
// Unified income helper: one tuple per income event, any source
gemIncome(user, g) :- register(user, _, g, _).
gemIncome(user, g) :- addGems(user, g).

gemsEarned(user, s) :- gemIncome(user, _), s = sum g: gemIncome(user, g).
gemsSpent(user, s)  :- upgradeVillage(user, _, _, _, _), s = sum c: upgradeVillage(user, _, _, _, c).

// Balance = earned - spent (only defined when both exist; CEGIS uses this for guard synthesis)
villageGems(user, s) :- gemsEarned(user, e), gemsSpent(user, sp), s := e - sp.

// Yield: cumulative sum of all yield increments from upgrade history
villageYield(user, s) :- upgradeVillage(user, _, _, _, _), s = sum y: upgradeVillage(user, _, _, y, _).

// Wool accounting
woolEarned(user, s) :- collectMoney(user, _, _), s = sum w: collectMoney(user, w, _).
woolSpent(user, s)  :- withdrawMoney(user, _),   s = sum a: withdrawMoney(user, a).

// Balance = earned - spent (only defined when both exist)
villageWool(user, s) :- woolEarned(user, e), woolSpent(user, sp), s := e - sp.
