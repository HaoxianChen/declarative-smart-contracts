// parameters
.decl *owner(p: address)
.decl *paused(p: bool)
.public paused(0)
.decl constructor()

// views
.decl allowed(p: address, p2: address, a: int)[0,1]
.public allowed(2)

// Constructor
owner(s) :- constructor(), msgSender(s).
paused(true) :- constructor().

// ownable
// .decl recv_transferownership(old: address, _new: address)
// .decl transferOwnership(old: address, _new: address)
//
// transferOwnership(s,_new) :- recv_transferownership(s, _new).
//                         // msgSender(s), owner(s), _new!=0.
// owner(_new) :- transferOwnership(_,_new).

// pausable
.decl recv_pause()
.decl pause()
pause() :- recv_pause(). // msgSender(s), owner(s), paused(a), a!=true.
paused(a) :- pause(), a:=true.

// basicToken
.decl *totalSupply(a:int)
.decl balances(p: address, a: int)[0]
.public balances(1)


.decl recv_transfer(from: address, to: address, a: int)
.decl transfer(from: address, to: address, a:int)

transfer(s,r,n) :- recv_transfer(s,r,n).
// , paused(false), msgSender(s), r!=0, balances(s,m), n<=m.

// standardToken
.decl recv_transferFrom(operator: address, from: address, to: address, a: int)
// .decl recv_approve(s: address, n: int)
.decl recv_increaseAllowance(o: address, s: address, d: int)
.decl recv_decreaseAllowance(o: address, s: address, d: int)
.public recv_transfer
.public recv_transferFrom
// .public recv_approve
.public recv_increaseAllowance
.public recv_decreaseAllowance

.decl transferFrom(operator: address, from: address, to: address, a: int)
transferFrom(s,f,r,n) :- recv_transferFrom(s,f,r,n).
//                          , r!=0, balances(f,m), n<=m,
//                     msgSender(s), allowed(f,s,a), n<=a.

.decl burn(p:address, n:int)
.decl mint(p:address, n:int)
.decl recv_mint(p:address, n:int)
.public recv_mint
.decl totalIn(p:address,n:int)[0]
.decl totalOut(p:address,n:int)[0]
transfer(s,r,n) :- transferFrom(_,s,r,n).
transfer(s,0,n) :- burn(s,n).
transfer(0,p,n) :- mint(p,n).
totalOut(p,s) :- transfer(p,_,_), s = sum n: transfer(p,_,n).
totalIn(p,s) :- transfer(_,p,_), s = sum n: transfer(_,p,n).
balances(p,s) :- totalOut(p,o), totalIn(p,i), s:=i-o.

mint(p,n) :- recv_mint(p,n).

.decl spentTotal(o:address, s:address, m:int)[0,1]
spentTotal(f,s,m) :- transferFrom(f,s,_,_), m = sum n: transferFrom(f,s,_,n).


// .decl approve(owner: address, operator:address, n: int)
// approve(s,o,n) :- recv_approve(o,n), msgSender(s).

.decl increaseAllowance(o: address, s: address, d: int)
// increaseAllowance(o,s,d) :- recv_approve(o,n), msgSender(s), allowed(o,s,m), n>m, d:=n-m.
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d). // msgSender(o).

.decl decreaseAllowance(o: address, s:address, d:int)[0,1]
// decreaseAllowance(o,s,d) :- recv_approve(o,n), msgSender(s), allowed(o,s,m), n<m, d:=m-n.
decreaseAllowance(o,s,d) :- recv_decreaseAllowance(o,s,d). // , msgSender(o),
                        // allowed(o,s,n), n>=m, d:=n-m.

.decl allowanceTotal(o:address, s:address, m:int)[0,1]
.decl decreaseTotal(o:address, s:address, m:int)[0,1]
allowanceTotal(o,s,m) :- increaseAllowance(o,s,_), m = sum n: increaseAllowance(o,s,n).
decreaseTotal(f,s,m) :- decreaseAllowance(f,s,_), m = sum n: decreaseAllowance(f,s,n).

allowed(f,s,m) :- allowanceTotal(f,s,n), spentTotal(f,s,l), decreaseTotal(f,s,d), m := n-l-d.


