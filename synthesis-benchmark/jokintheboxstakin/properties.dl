// UDF-based guard checks (retain recv_tx - UDF only supported in violation rules)
invalidLockPeriod() :- recv_stake(_, _, lockPeriod), isValidLockPeriod(lockPeriod, false).

invalidWithdrawSignature() :-
  recv_withdraw(earnings, affiliateEarnings, inETH, messageHash, v, r, s),
  msgSender(sender),
  total := earnings + affiliateEarnings,
  isValidSignature(sender, total, inETH, messageHash, v, r, s, false).

repeatedUnstake() :- recv_unstake(stakeId), msgSender(sender), onceUnstake(sender, stakeId, true).
