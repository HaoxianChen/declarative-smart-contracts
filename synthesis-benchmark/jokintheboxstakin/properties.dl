////////////////////////////
// Jok In The Box Staking (properties)
// Encode "require" checks as invalidTx() violations so CEGIS learns guards.
////////////////////////////

// 1) Vulnerability fix: cannot unstake twice.
invalidTx() :-
  recv_unstake(stakeId),
  msgSender(p),
  onceUnstake(p, stakeId, u),
  u == true.

// 2) Lock period check (day-based):
// require(currentDay > stakedDay + lockPeriod)  =>  invalid when <=.
invalidTx() :-
  recv_unstake(stakeId),
  msgSender(p),
  stakeLockPeriod(p, stakeId, lock),
  stakeStakedDay(p, stakeId, staked),
  now(t),
  t <= staked + lock.

// 3) stake: amount must be positive.
invalidTx() :- recv_stake(_, amount, _), amount <= 0.

// 4) stake: lockPeriod must be one of {1, 30, 60, 90} days.
// Uses the isValidLockPeriod UDF so the synthesized contract calls the pure helper.
invalidTx() :-
  recv_stake(_, _, lockPeriod),
  isValidLockPeriod(lockPeriod, ok),
  ok == false.

// 5) withdraw: signature must be valid (ECDSA check via UDF).
invalidTx() :-
  recv_withdraw(earnings, affiliateEarnings, inETH, messageHash, v, r, s),
  msgSender(sender),
  total := earnings + affiliateEarnings,
  isValidSignature(sender, total, inETH, messageHash, v, r, s, valid),
  valid == false.

// 6) withdraw (ETH path): total must be < maxPercentage% of contract ETH balance.
invalidTx() :-
  recv_withdraw(earnings, affiliateEarnings, true, messageHash, v, r, s),
  total := earnings + affiliateEarnings,
  maxPercentage(maxPct),
  hundred(c),
  thisBalance(bal),
  total * c >= bal * maxPct.

// 7) withdraw (token path): total must be < maxPercentage% of JOK token balance.
invalidTx() :-
  recv_withdraw(earnings, affiliateEarnings, false, messageHash, v, r, s),
  total := earnings + affiliateEarnings,
  maxPercentage(maxPct),
  hundred(c),
  jokTokenBalance(tokenBal),
  total * c >= tokenBal * maxPct.
