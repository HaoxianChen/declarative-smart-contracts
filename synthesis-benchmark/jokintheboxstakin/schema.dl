////////////////////////////
// Jok In The Box Staking (minimal, vulnerability-focused)
//
// Goal: model stake/unstake + lock period (day-based) and prevent re-unstake.
// Notes:
// - We abstract away ERC20 transfers and signatures.
// - `stakeId` is provided by the trace and corresponds to Solidity `stakeIndex`.
////////////////////////////

// Transactions (recv_* are public interfaces)
.decl recv_stake(stakeId: uint, amount: uint, lockPeriod: uint)
.decl stake(staker: address, stakeId: uint, amount: uint, lockPeriod: uint, stakedDay: uint)
.public recv_stake

.decl recv_unstake(stakeId: uint)
.decl unstake(staker: address, stakeId: uint, unstakedDay: uint)
.public recv_unstake

// State (keyed by (staker, stakeId))
.decl stakeAmount(staker: address, stakeId: uint, amount: uint)[0,1]
.decl stakeLockPeriod(staker: address, stakeId: uint, lockPeriod: uint)[0,1]
.decl stakeStakedDay(staker: address, stakeId: uint, stakedDay: uint)[0,1]
.decl stakeStatus(staker: address, stakeId: uint, unstaked: bool)[0,1]
.decl unstakedDay(staker: address, stakeId: uint, day: uint)[0,1]

// Views (optional for inspection)
.public stakeStatus(2)
.public stakeAmount(2)
.public stakeLockPeriod(2)
.public stakeStakedDay(2)

// Initialization
.decl constructor()
.decl *initialized(b: bool)
.public initialized(0)

// Properties / validity
.decl invalidTx()
.violation invalidTx

