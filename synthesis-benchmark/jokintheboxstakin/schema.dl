////////////////////////////
// Jok In The Box Staking
//
// Models the core economic loop: stake / unstake / withdraw.
// Key improvements over the minimal version:
//   - isValidLockPeriod UDF enforces the four valid lock durations (1/30/60/90 days).
//   - ethTax tracks the ETH fee rate initialised by the constructor.
//   - totalStaked tracks cumulative staked amount for withdrawal limit semantics.
//   - nonce relation initialisation rule prevents replay-protection bypass on first withdraw.
////////////////////////////

// Transactions (recv_* are public interfaces)
.decl recv_stake(stakeId: uint, amount: uint > 0, lockPeriod: uint > 0)
.decl stake(staker: address, stakeId: uint, amount: uint, lockPeriod: uint, stakedDay: uint)
.public recv_stake

.decl recv_unstake(stakeId: uint)
.decl unstake(staker: address, stakeId: uint, unstakedDay: uint)
.public recv_unstake

// Withdraw: validity checks (signature + withdrawal limit)
.decl recv_withdraw(
  earnings: uint,
  affiliateEarnings: uint,
  inETH: bool,
  messageHash: bytes32,
  v: uint,
  r: bytes32,
  s: bytes32
)
.public recv_withdraw

// Semantic relation for withdraw
.decl withdraw(sender: address, total: uint)

// State (keyed by (staker, stakeId))
.decl stakeAmount(staker: address, stakeId: uint, amount: uint)[0,1]
.decl stakeLockPeriod(staker: address, stakeId: uint, lockPeriod: uint)[0,1]
.decl stakeStakedDay(staker: address, stakeId: uint, stakedDay: uint)[0,1]
.decl stakeStatus(staker: address, stakeId: uint, unstaked: bool)[0,1]
.decl unstakedDay(staker: address, stakeId: uint, day: uint)[0,1]
// Temporal marker: whether this stake has ever been unstaked.
.decl onceUnstake(staker: address, stakeId: uint, b: bool)[0,1]

// Per-sender withdrawal nonce (replay protection)
.decl nonce(sender: address, n: uint)[0]

// Views
.public stakeStatus(2)
.public stakeAmount(2)
.public stakeLockPeriod(2)
.public stakeStakedDay(2)

// Initialization
.decl constructor()
.decl *initialized(b: bool)
.public initialized(0)

// Configuration
.decl *maxPercentage(value: uint)
.public maxPercentage(0)

// ETH fee rate (percentage, 0-100); initialised to 5 by constructor.
.decl *ethTax(rate: uint)
.public ethTax(0)

// Constant helper to avoid numeric literals in arithmetic expressions.
.decl *hundred(value: uint)
.public hundred(0)

// Cumulative staked amount (used for withdrawal limit context).
.decl *totalStaked(n: uint)
.public totalStaked(0)

// UDFs (last column is the return value variable)

// isValidSignature: state-reading — verifies ECDSA signature using per-user nonce.
.decl isValidSignature(
  sender: address,
  totalEarnings: uint,
  inETH: bool,
  messageHash: bytes32,
  v: uint,
  r: bytes32,
  s: bytes32,
  valid: bool
)
.udf isValidSignature

// jokTokenBalance: state-reading — JOK token balance held by this contract.
.decl jokTokenBalance(balance: uint)
.udf jokTokenBalance

// isValidLockPeriod: pure — returns true for lock durations {1, 30, 60, 90} days.
.decl isValidLockPeriod(lockPeriod: uint, ok: bool)
.udf isValidLockPeriod

// Properties / validity
.decl invalidLockPeriod()
.violation invalidLockPeriod

.decl invalidWithdrawSignature()
.violation invalidWithdrawSignature

.decl repeatedUnstake()
.violation repeatedUnstake

.decl invalidTx()
.violation invalidTx
