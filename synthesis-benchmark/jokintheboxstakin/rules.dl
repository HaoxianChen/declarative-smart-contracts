////////////////////////////
// Jok In The Box Staking (rules)
// Day-based time: `now(t)` is interpreted as day counter (block.timestamp / 1 days).
////////////////////////////

// Initialization state (ensures constructor is present in generated Solidity)
initialized(true) :- constructor().

// Defaults matching the original contract
maxPercentage(10) :- constructor().
hundred(100)      :- constructor().
ethTax(5)         :- constructor().   // 5% ETH fee (matches constructor init)
totalStaked(0)    :- constructor().

// Transaction placeholder rules
stake(p, stakeId, amount, lockPeriod, day) :-
  recv_stake(stakeId, amount, lockPeriod),
  msgSender(p),
  now(day).

// Unstake is only valid when:
// 1) the stake exists and has not been unstaked before,
// 2) the lock period has finalized (currentDay > stakedDay + lockPeriod).
unstake(p, stakeId, day) :-
  recv_unstake(stakeId),
  msgSender(p),
  onceUnstake(p, stakeId, false),
  stakeStatus(p, stakeId, false),
  stakeLockPeriod(p, stakeId, lock),
  stakeStakedDay(p, stakeId, staked),
  now(day),
  day > staked + lock.

// State updates — stake fields split into 1-value maps for synthesis compatibility.
stakeAmount(p, stakeId, amount) :-
  stake(p, stakeId, amount, _, _).

stakeLockPeriod(p, stakeId, lockPeriod) :-
  stake(p, stakeId, _, lockPeriod, _).

stakeStakedDay(p, stakeId, day) :-
  stake(p, stakeId, _, _, day).

// stakeStatus: false on creation, true after unstake.
stakeStatus(p, stakeId, false) :-
  stake(p, stakeId, _, _, _).

stakeStatus(p, stakeId, true) :-
  unstake(p, stakeId, _).

// onceUnstake: false on creation, permanently true after unstake.
onceUnstake(p, stakeId, false) :-
  stake(p, stakeId, _, _, _).

onceUnstake(p, stakeId, true) :-
  unstake(p, stakeId, _).

// Record unstaked day.
unstakedDay(p, stakeId, day) :-
  unstake(p, stakeId, day).

// Nonce initialisation: set to 0 when a user creates their first stake.
// This ensures that nonce(sender, n_old) is defined for the first withdraw,
// allowing the increment rule below to fire and advance the replay counter.
nonce(p, 0) :- stake(p, _, _, _, _).

// Withdraw semantic rule.
withdraw(sender, total) :-
  recv_withdraw(earnings, affiliateEarnings, inETH, messageHash, v, r, s),
  msgSender(sender),
  total := earnings + affiliateEarnings.

// Nonce increment: after each withdrawal the per-sender nonce advances by 1.
// Prevents replay of the same (v, r, s) in a subsequent withdraw call.
nonce(sender, n_new) :-
  withdraw(sender, _),
  nonce(sender, n_old),
  n_new := n_old + 1.

// totalStaked: cumulative sum of all staked amounts (approximation — does not
// subtract unstaked amounts; sufficient for CEGIS guard learning on withdraw limits).
totalStaked(s) :- stake(_, _, _, _, _), s = sum a: stake(_, _, a, _, _).
