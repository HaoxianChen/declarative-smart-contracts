////////////////////////////
// Jok In The Box Staking (rules)
// Day-based time: `now(t)` is interpreted as day counter (see your choice A).
////////////////////////////

// Initialization state (ensures constructor is present in generated Solidity)
initialized(true) :- constructor().

// Defaults (matching the original contract)
maxPercentage(10) :- constructor().
hundred(100) :- constructor().

// Transaction placeholder rules
// Derive semantic tx relations from recv_* and implicit context.
stake(p, stakeId, amount, lockPeriod, day) :-
  recv_stake(stakeId, amount, lockPeriod),
  msgSender(p),
  now(day).

// Unstake is only meaningful when:
// 1) the stake exists,
// 2) it has not been unstaked before,
// 3) lock period has finalized.
unstake(p, stakeId, day) :-
  recv_unstake(stakeId),
  msgSender(p),
  onceUnstake(p, stakeId, false),
  stakeStatus(p, stakeId, false),
  stakeLockPeriod(p, stakeId, lock),
  stakeStakedDay(p, stakeId, staked),
  now(day),
  day > staked + lock.

// State updates
// Stake fields are written on stake (split into 1-value maps for synthesis compatibility).
stakeAmount(p, stakeId, amount) :-
  stake(p, stakeId, amount, _, _).

stakeLockPeriod(p, stakeId, lockPeriod) :-
  stake(p, stakeId, _, lockPeriod, _).

stakeStakedDay(p, stakeId, day) :-
  stake(p, stakeId, _, _, day).

// stakeStatus starts as false on stake, and becomes true on unstake.
stakeStatus(p, stakeId, false) :-
  stake(p, stakeId, _, _, _).

stakeStatus(p, stakeId, true) :-
  unstake(p, stakeId, _).

// onceUnstake starts as false on stake and turns true permanently after unstake.
onceUnstake(p, stakeId, false) :-
  stake(p, stakeId, _, _, _).

onceUnstake(p, stakeId, true) :-
  unstake(p, stakeId, _).

// Record unstaked day
unstakedDay(p, stakeId, day) :-
  unstake(p, stakeId, day).

// Withdraw semantic rule: records that the sender performed a withdrawal.
// All recv_withdraw fields are named (not wildcards) so that the predicate enumerator
// can bind isValidSignature using inETH, messageHash, v, r, s from the tx literal.
withdraw(sender, total) :-
  recv_withdraw(earnings, affiliateEarnings, inETH, messageHash, v, r, s),
  msgSender(sender),
  total := earnings + affiliateEarnings.

// Nonce increment: after each withdrawal the per-sender nonce advances by 1.
// This models the nonce[beneficiary]++ in udf.sol::isValidSignature, ensuring that
// the same (v, r, s) cannot be replayed once the nonce has changed.
nonce(sender, n_new) :-
  withdraw(sender, _),
  nonce(sender, n_old),
  n_new := n_old + 1.
