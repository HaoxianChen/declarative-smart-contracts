////////////////////////////
// LevelReferralControllerV2 rules
////////////////////////////

// Constructor: deployer becomes owner and initial updater; epoch boundary set to 10
owner(s)         :- constructor(), msgSender(s).
updater(s)       :- constructor(), msgSender(s).
currentEpoch(10) :- constructor().

////////////////////
// setReferrer
////////////////////

setReferrer(trader, referrer) :-
    recv_setReferrer(referrer),
    msgSender(trader).

referredBy(trader, referrer) :- setReferrer(trader, referrer).

////////////////////
// updatePoint
// Only fires when the trader has an established referral relationship.
// Trading points accumulate for the trader; referral points for the referrer.
////////////////////

updatePoint(epoch, trader, referrer, point) :-
    recv_updatePoint(epoch, trader, point),
    msgSender(s), updater(u), u == s,
    referredBy(trader, referrer).

tradingPointEvent(epoch, trader, point)   :- updatePoint(epoch, trader, _, point).
referralPointEvent(epoch, referrer, point) :- updatePoint(epoch, _, referrer, point).

// Sum all trading/referral point events per (epoch, user)
tradingPoint(epoch, user, total) :-
    tradingPointEvent(epoch, user, _),
    total = sum p : tradingPointEvent(epoch, user, p).

referralPoint(epoch, user, total) :-
    referralPointEvent(epoch, user, _),
    total = sum p : referralPointEvent(epoch, user, p).

////////////////////
// nextEpoch: record TWAP and vesting parameters for a given epoch
////////////////////

nextEpoch(epoch, twap, t, vestingDuration) :-
    recv_nextEpoch(epoch, twap, vestingDuration),
    now(t).

epochTWAP(epoch, twap)                       :- nextEpoch(epoch, twap, _, _).
epochAllocationTime(epoch, allocationTime)   :- nextEpoch(epoch, _, allocationTime, _).
epochVestingDuration(epoch, vestingDuration) :- nextEpoch(epoch, _, _, vestingDuration).

////////////////////
// claimMultiple (single-epoch)
//
// Delegates the full reward computation (tier discounts, TWAP pricing, vesting)
// to the computeClaimable UDF.  The UDF reads tradingPoint, referralPoint,
// epochTWAP, epochAllocationTime, epochVestingDuration, and claimed from storage.
////////////////////

claimMultiple(epoch, user, to, reward) :-
    recv_claimMultiple(epoch, to),
    msgSender(user),
    currentEpoch(e), epoch < e,
    computeClaimable(epoch, user, reward),
    reward > 0.

// Seed claimed=0 as soon as points exist for this (epoch,user), so claimed is
// always defined before the first claimMultiple fires.
claimEvent(epoch, user, 0) :- tradingPointEvent(epoch, user, _).
claimEvent(epoch, user, 0) :- referralPointEvent(epoch, user, _).

// Record each successful claim amount
claimEvent(epoch, user, reward) :- claimMultiple(epoch, user, _, reward).

// Cumulative claimed = sum of all claimEvent amounts
claimed(epoch, user, c) :-
    claimEvent(epoch, user, _),
    c = sum a : claimEvent(epoch, user, a).
