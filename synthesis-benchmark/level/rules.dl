////////////////////////////
// levelClaimMultiple rules (fixed semantics)
// Time: now(t) is block.timestamp (seconds), but we don't need it here.
////////////////////////////

// Constructor: set a constant currentEpoch (just to support epoch < currentEpoch checks).
currentEpoch(10) :- constructor().

////////////////////
// Transaction placeholder rules
////////////////////

allocate(epoch, user, amount) :-
  recv_allocate(epoch, user, amount).

// Record allocation events (used to compute totalReward).
allocateEvent(epoch, user, amount) :-
  allocate(epoch, user, amount).

// Seed claim events so that claimed(epoch,user,0) is defined immediately after allocation.
// We avoid typing issues by assigning a typed variable z (uint) to 0.
claimEvent(epoch, user, z) :-
  allocateEvent(epoch, user, _),
  z := 0.

////////////////////
// Derived states
////////////////////

// Abstract total reward: sum of allocations for (epoch,user).
totalReward(epoch, user, total) :-
  allocateEvent(epoch, user, _),
  total = sum amount: allocateEvent(epoch, user, amount).

// Claimed is cumulative: sum of all claimEvent amounts for (epoch,user).
claimed(epoch, user, c) :-
  claimEvent(epoch, user, _),
  c = sum amount: claimEvent(epoch, user, amount).

// Claimable is the remaining amount: max(totalReward - claimed, 0).
// We only materialize the positive case and use invalidTx to block the non-positive case.
claimable(epoch, user, r) :-
  totalReward(epoch, user, total),
  claimed(epoch, user, c),
  total > c,
  r := total - c.

////////////////////
// claimMultiple (single-epoch) fixed semantics
////////////////////

claimMultiple(epoch, user, to, reward) :-
  recv_claimMultiple(epoch, to),
  msgSender(user),
  currentEpoch(e),
  epoch < e,
  claimable(epoch, user, reward).

// Each successful claimMultiple claims exactly `reward` for that epoch/user.
// This induces claimed += reward via the claimed=sum(claimEvent) definition.
claimEvent(epoch, user, reward) :-
  claimMultiple(epoch, user, _, reward).

