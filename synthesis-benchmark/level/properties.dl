////////////////////////////
// levelClaimMultiple properties (fixed semantics)
//
// We encode "require" checks as invalidTx() so that synthesis can learn guards.
////////////////////////////

// Must only claim for past epochs.
invalidTx() :-
  recv_claimMultiple(epoch, _),
  currentEpoch(e),
  epoch >= e.

// Must have positive claimable (i.e., totalReward > claimed).
// If totalReward <= claimed, a claimMultiple attempt is invalid.
invalidTx() :-
  recv_claimMultiple(epoch, _),
  msgSender(user),
  totalReward(epoch, user, total),
  claimed(epoch, user, c),
  total <= c.

