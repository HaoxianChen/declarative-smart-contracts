////////////////////////////
// LevelReferralControllerV2 - high-fidelity model with UDF
//
// Key transactions (matching original):
//   setReferrer(referrer)             <- trader establishes referral relationship
//   updatePoint(epoch, trader, point) <- updater records trading/referral points
//                                        (simplified: epoch is explicit parameter;
//                                         original derives it from currentEpoch)
//   nextEpoch(epoch, twap, vestDur)   <- record TWAP and vesting info per epoch
//                                        (simplified: epoch is explicit parameter)
//   claimMultiple(epoch, to)          <- user claims rewards for a past epoch
//
// UDF:
//   computeClaimable(epoch, user, result)
//     Reads state to compute claimable reward including:
//       (tradingPoint * 5% + referralPoint * 5%) / TWAP * vestingRatio - claimed
//     Simplified from original: uses fixed tier-1 rates (5%) instead of dynamic tiers.
////////////////////////////

.decl constructor()

// Access control
.decl *owner(p: address)
.decl *updater(p: address)

// Epoch boundary for claim eligibility
.decl *currentEpoch(e: uint)
.public currentEpoch(0)

// Epoch metadata (recorded via nextEpoch)
.decl epochTWAP(epoch: uint, twap: uint)[0]
.decl epochAllocationTime(epoch: uint, t: uint)[0]
.decl epochVestingDuration(epoch: uint, d: uint)[0]

// Referral relationships
.decl referredBy(trader: address, referrer: address)[0]

// Point accumulation events (per epoch)
.decl tradingPointEvent(epoch: uint, trader: address, point: uint)
.decl referralPointEvent(epoch: uint, referrer: address, point: uint)

// Point state: sum of all events per (epoch, user)
.decl tradingPoint(epoch: uint, user: address, amount: uint)[0,1]
.decl referralPoint(epoch: uint, user: address, amount: uint)[0,1]

// Claim state: cumulative amount claimed per (epoch, user)
.decl claimEvent(epoch: uint, user: address, amount: uint)
.decl claimed(epoch: uint, user: address, amount: uint)[0,1]

// UDF: full claimable formula (tier-1 rates + vesting + subtract already claimed)
.decl computeClaimable(epoch: uint, user: address, result: uint)
.udf computeClaimable

// ── Transactions ─────────────────────────────────────────────────────────────

.decl recv_setReferrer(referrer: address)
.public recv_setReferrer
.decl setReferrer(trader: address, referrer: address)

.decl recv_updatePoint(epoch: uint, trader: address, point: uint)
.public recv_updatePoint
.decl updatePoint(epoch: uint, trader: address, referrer: address, point: uint)

.decl recv_nextEpoch(epoch: uint, twap: uint, vestingDuration: uint)
.public recv_nextEpoch
.decl nextEpoch(epoch: uint, twap: uint, allocationTime: uint, vestingDuration: uint)

.decl recv_claimMultiple(epoch: uint, to: address)
.public recv_claimMultiple
.decl claimMultiple(epoch: uint, user: address, to: address, reward: uint)

// ── Public views ─────────────────────────────────────────────────────────────

.public tradingPoint(2)
.public referralPoint(2)
.public claimed(2)
.public epochTWAP(1)

// ── Properties ───────────────────────────────────────────────────────────────

.decl invalidTx()
.violation invalidTx
