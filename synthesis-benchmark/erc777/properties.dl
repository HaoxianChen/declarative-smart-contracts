// operator consistency: default operator should not also be in per-user operators map
inconsistentOperator(p,o) :-
    defaultOperator(o,b1), b1==true,
    operators(p,o,b2), b2==true.

// no negative balances or allowances
negativeBalance(p,n) :- balanceOf(p,n), n<0, p!=0.
negativeAllowance(s,p,n) :- allowance(s,p,n), n<0, s!=0, p!=0.

// authority rules (retain recv_tx)
unauthorizedMint() :- recv_mint(_,_), owner(o), msgSender(s), o!=s.
unauthorizedBurn() :- recv_burn(_,_), owner(o), msgSender(s), o!=s.

// once sentinel for unauthorized operator actions
unauthorizedOperatorSend() :- onceUnauthorizedOperatorSend(b), b==true.
unauthorizedOperatorBurn() :- onceUnauthorizedOperatorBurn(b), b==true.
