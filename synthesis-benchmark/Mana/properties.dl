////////////////////
// Safety properties (preserve original violations)
////////////////////

alwaysLessThanIssuance(false) :- bucketAmount(a), issuance(b), a>b.
moreThanCap(true) :- alwaysLessThanIssuance(false).

////////////////////
// Transaction validity
////////////////////

// buyTokens: p!=0, v!=0, and cap >= weiRaised_1 + v
invalidTx() :- recv_buyTokens(p,_), p==0.
invalidTx() :- recv_buyTokens(_,v), v==0.
// Domain tightening: disallow negative purchases (prevents weird models that push synthesis to "disable" the tx).
invalidTx() :- recv_buyTokens(_,v), v<0.
invalidTx() :- recv_buyTokens(_,v), weiRaised_1(b), cap(c), b+v>c.

// finalize: only owner, not finalized, and weiRaised_1 > cap (legacy condition)
invalidTx() :- recv_finalize(), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_finalize(), crowdsaleFinalized(b), b==true.
// Align with buyTokens cap constraint: allow finalize when weiRaised_1 has reached cap.
invalidTx() :- recv_finalize(), cap(n), weiRaised_1(m), m<n.

// beginContinuousSale: only owner and after finalized
invalidTx() :- recv_beginContinuousSale(), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_beginContinuousSale(), crowdsaleFinalized(b), b==false.

// buyToken1: p!=0, v!=0, must be started, and issuance >= bucketAmount + v
invalidTx() :- recv_buyToken1(p,_), p==0.
invalidTx() :- recv_buyToken1(_,v), v==0.
invalidTx() :- recv_buyToken1(_,v), v<0.
invalidTx() :- recv_buyToken1(_,_), continuousSaleStarted(b), b==false.
invalidTx() :- recv_buyToken1(_,v), bucketAmount(b), issuance(c), b+v>c.

