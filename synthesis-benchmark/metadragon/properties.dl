////////////////////////////
// MetaDragon properties
//
// Encodes the vulnerability fix and token/NFT solvency invariants.
//
// Vulnerability:
//   - _update hook should ONLY trigger transform when to == address(this).
//   - Passing a tokenId (isValidTokenId == true) via the ERC20 update path is invalid.
//
// Fix:
//   - Only `to == address(this)` triggers transform; `to == erc721` must be blocked.
//   - isValidTokenId(value) is used to distinguish tokenId vs ERC20 amount.
////////////////////////////

// Vulnerability fix A: to must equal address(this) for transform to be triggered.
invalidTx() :- recv_update(to, _), this(t), to != t.

// Vulnerability fix B: tokenId values must not be passed as ERC20 amounts via update.
// Uses the isValidTokenId UDF: if value is a valid tokenId (<30001), reject via update.
invalidTx() :- recv_update(_, value), isValidTokenId(value, ok), ok == true.

// erc20ToNft: amount must be positive and divisible by TRANSFORM_PRICE
invalidTx() :- recv_erc20ToNft(amount), amount <= 0.

// nftToErc20: tokenId must be a valid tokenId
invalidTx() :- recv_nftToErc20(tokenId), isValidTokenId(tokenId, ok), ok == false.

// ERC20 transfer guards
invalidTx() :- recv_transfer(_, amount), amount <= 0.
invalidTx() :- recv_transfer(to, _), to == 0.

// Solvency violations
negativeBalance(user, n)    :- balanceOf(user, n), n < 0.
negativeNftBalance(user, n) :- nftBalance(user, n), n < 0.
