////////////////////////////
// metadragon properties (A + B1)
//
// We encode the FIX as invalidTx() so CEGIS synthesizes guards for `update`.
// Each invalidTx rule uses exactly ONE functor, so predicate extraction works.
////////////////////////////

// Fix for A (and also enforces your requirement "only allow to==this"):
// If `to != this`, the transform-triggering entry is invalid.
invalidTx() :-
  recv_update(to, _),
  this(t),
  to != t.

// Fix for B1:
// Disallow tokenId values via this entry.
// isValidTokenId(tokenId) == (tokenId < 30001)
invalidTx() :-
  recv_update(_, value),
  value < 30001.

