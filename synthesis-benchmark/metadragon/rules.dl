////////////////////////////
// MetaDragon rules
////////////////////////////

totalSupply(260000000) :- constructor().
totalNFTs(0)          :- constructor().

// Token balance accounting
// Income events
tokenIncome(user, n) :- nftToErc20(user, _, n).          // NFT -> token: receive tokens

// Expense events
tokenExpense(user, n) :- erc20ToNft(user, n, _).          // ERC20 -> NFT: burn tokens
tokenExpense(from, n) :- transfer(from, _, n).            // ERC20 transfer out

// Token balance = total income - total expense (relative to constructor mint)
tokensIn(user, s)  :- tokenIncome(user, _), s = sum n: tokenIncome(user, n).
tokensOut(user, s) :- tokenExpense(user, _), s = sum n: tokenExpense(user, n).
balanceOf(user, s) :- tokensIn(user, i), tokensOut(user, o), s := i - o.

// NFT balance accounting
nftIncome(user, n)  :- erc20ToNft(user, _, n).            // ERC20 -> NFT: receive NFTs
nftExpense(user, 1) :- nftToErc20(user, _, _).            // NFT -> token: lose 1 NFT

nftsIn(user, s)      :- nftIncome(user, _), s = sum n: nftIncome(user, n).
nftsOut(user, s)     :- nftExpense(user, _), s = sum n: nftExpense(user, n).
nftBalance(user, s)  :- nftsIn(user, i), nftsOut(user, o), s := i - o.

// Total NFTs across all users
totalNFTs(n) :- erc20ToNft(_, _, _), n = sum k: erc20ToNft(_, _, k).
