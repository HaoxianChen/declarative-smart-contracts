////////////////////////////
// metadragon (P404Token / MetaDragon) - vulnerability-focused
//
// Cover A+B (your definition):
// A: `to == erc721` triggers transform (amount path).
// B1: tokenId path should be forbidden via ERC20 transfer entry.
//
// Fixed semantics target:
// - ONLY allow `to == this` to trigger transform.
// - Forbid tokenId values in this entry: require value >= 30001.
//
// Notes:
// - We DO NOT compile Solidity here (imports missing). This is a Datalog benchmark.
// - We model the internal `_update(to,value)` trigger as a public tx `recv_update(to,value)`.
// - `this(t)` is a built-in relation yielding address(this).
////////////////////////////

// Initialization
.decl constructor()
.decl *initialized(b: bool)
.public initialized(0)

// Transactions (model `_update(to,value)` as the external trigger)
.decl recv_update(to: address, value: uint)
.public recv_update

// Derived transaction relation (semantic event: "transform is attempted")
.decl update(user: address, to: address, value: uint)

// Minimal observable state: how many transforms each user executed
.decl transformCount(user: address, n: uint)[0]
.public transformCount(1)

// Validity
.decl invalidTx()
.violation invalidTx

