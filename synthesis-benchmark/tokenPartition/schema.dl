// parameters
.decl *owner(p: address)

// views
.decl *totalSupply(n: int >= 0)
.decl totalSupplyByPartition(q:int, n:int >= 0)[0]
.decl balanceOfByPartition(p: address, q:int, n: int >= 0)[0,1]
.decl constructor()


// Transactions
.decl issueByPartition(p: address, q:int, n: int)
.decl recv_issueByPartition(p: address <> 0, q:int, n: int > 0)
.decl redeemByPartition(p: address, q:int, n: int)
.decl recv_redeemByPartition(p: address <> 0, q:int, n: int > 0)
.decl transferByPartition(s: address, r: address, q:int, n: int)
.decl recv_transferByPartition(s: address <> 0, r: address <> 0, q:int, n: int > 0)

// Interfaces
.public recv_issueByPartition
.public recv_redeemByPartition
.public recv_transferByPartition
.public balanceOfByPartition(2)
.public totalSupply(0)
.public totalSupplyByPartition(1)

.decl totalMint(p: address, q:int, n: int)[0,1]
.decl totalBurn(p: address, q:int, n: int)[0,1]
.decl totalOut(p: address, q:int, n: int)[0,1]
.decl totalIn(p: address, q:int, n: int)[0,1]

.decl *allMint(n: int)
.decl *allBurn(n: int)

.decl issueTotalByPartition(q: int, n: int)[0]
.decl redeemTotalByPartition(q: int, n: int)[0]


// Properties
.decl negativeBalance(p:address,q:int,n:int)[0]
.violation negativeBalance

.decl unauthorizedIssueByPartition()
.violation unauthorizedIssueByPartition

.decl unauthorizedRedeemByPartition()
.violation unauthorizedRedeemByPartition

.decl invalidTx()
.violation invalidTx

// Transaction placeholder rules
issueByPartition(p,q,n) :- recv_issueByPartition(p,q,n).
redeemByPartition(p,q,n) :- recv_redeemByPartition(p,q,n).
transferByPartition(s,r,q,n) :- recv_transferByPartition(s,r,q,n).
