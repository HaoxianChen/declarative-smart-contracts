// no negative balances for non-zero addresses
negativeBalance(p,q,n) :- balanceOfByPartition(p,q,n), n<0, p!=0.

// authority rules (retain recv_tx)
unauthorizedIssueByPartition() :- recv_issueByPartition(_,_,_), owner(o), msgSender(s), s!=o.
unauthorizedRedeemByPartition() :- recv_redeemByPartition(_,_,_), owner(o), msgSender(s), s!=o.
