// no negative balances for non-zero addresses
negativeBalance(p,q,n) :- balanceOfByPartition(p,q,n), n<0, p!=0.

// only owner can issue or redeem tokens
invalidTx() :- recv_issueByPartition(_,_,_), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_redeemByPartition(_,_,_), owner(o), msgSender(s), o!=s.

// amounts must be positive
invalidTx() :- recv_issueByPartition(_, _, n), n <= 0.
invalidTx() :- recv_redeemByPartition(_, _, n), n <= 0.
invalidTx() :- recv_transferByPartition(_, _, _, n), n <= 0.

// only the holder may transfer their partition balance
invalidTx() :- recv_transferByPartition(s, _, _, _), msgSender(m), s != m.

// cannot redeem or transfer more than balance
invalidTx() :- recv_redeemByPartition(p, q, n), balanceOfByPartition(p, q, b), n > b.
invalidTx() :- recv_transferByPartition(s, _, q, n), balanceOfByPartition(s, q, b), n > b.
