// total supply equals total balances
unequalBalance(s,n) :- totalBalances(s), totalSupply(n), s!=n.

// no negative balances / allowances
negativeBalance(p,n) :- balanceOf(p,n), n<0, p!=0.
negativeAllowance(s,p,n) :- allowance(s,p,n), n<0, s!=0, p!=0.

// no transfer / transferFrom after paused
invalidTx() :- paused(b), b==true, recv_transfer(_,_,_).
invalidTx() :- paused(b), b==true, recv_transferFrom(_,_,_,_).

// transfer: non-zero addresses, positive amount, sender has sufficient balance
invalidTx() :- recv_transfer(s,_,_), s==0.
invalidTx() :- recv_transfer(_,r,_), r==0.
invalidTx() :- recv_transfer(_,_,n), n<=0.
invalidTx() :- recv_transfer(s,_,n), balanceOf(s,m), n>m.

// transferFrom: non-zero addresses, positive amount, owner has sufficient balance and allowance
invalidTx() :- recv_transferFrom(o,_,_,_), o==0.
invalidTx() :- recv_transferFrom(_,r,_,_), r==0.
invalidTx() :- recv_transferFrom(_,_,_,n), n<=0.
invalidTx() :- recv_transferFrom(o,_,_,n), balanceOf(o,m), n>m.
invalidTx() :- recv_transferFrom(o,_,s,n), allowance(o,s,k), n>k.

// only owner can mint / burn
invalidTx() :- recv_mint(_,_), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_burn(_,_), owner(o), msgSender(s), o!=s.
// only owner can pause / unpause
invalidTx() :- recv_pause(), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_unpause(), owner(o), msgSender(s), o!=s.
// burn: amount must be positive; target account must have sufficient balance
invalidTx() :- recv_burn(_,n), n<=0.
invalidTx() :- recv_burn(p,n), balanceOf(p,m), n>m.
// decreaseAllowance: decrease amount must be positive
invalidTx() :- recv_decreaseAllowance(_,_,n), n<=0.
