// total balances must equal total supply (per tokenId)
unequalBalance(t,s,n) :- totalBalances(t,s), totalSupply(t,n), s!=n.

// no negative balances or allowances
negativeBalance(t,p,n) :- balanceOf(t,p,n), n<0, p!=0.
negativeAllowance(t,s,p,n) :- allowance(t,s,p,n), n<0, s!=0, p!=0.

// authority rules (retain recv_tx)
unauthorizedMint() :- recv_mint(_,_,_), owner(o), msgSender(s), o!=s.
unauthorizedBurn() :- recv_burn(_,_,_), owner(o), msgSender(s), o!=s.
