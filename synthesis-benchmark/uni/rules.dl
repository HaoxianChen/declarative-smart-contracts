// UNI state rules
minter(m) :- constructor(m, _).
totalSupply(s) :- constructor(_, s).

// setMinter updates the minter (last call wins in monotone model – simplified)
minter(p) :- setMinter(p).

// All participants (any address appearing in any balance-relevant event)
participant(p) :- mint(p, _).
participant(p) :- transfer(p, _, _).
participant(p) :- transfer(_, p, _).

// Entry relations: real facts + sentinel 0 per participant
mintEntry(p, n) :- mint(p, n).
mintEntry(p, 0) :- participant(p).
inEntry(p, n)   :- transfer(_, p, n).
inEntry(p, 0)   :- participant(p).
outEntry(p, n)  :- transfer(p, _, n).
outEntry(p, 0)  :- participant(p).

// Always-defined aggregations for all participants
totalMint(p, s) :- mintEntry(p, _), s = sum n: mintEntry(p, n).
totalIn(p, s)   :- inEntry(p, _),   s = sum n: inEntry(p, n).
totalOut(p, s)  :- outEntry(p, _),  s = sum n: outEntry(p, n).

// balanceOf always defined for all participants
balanceOf(p, s) :- totalMint(p, m), totalIn(p, i), totalOut(p, o), s := m+i-o.

allMint(s) :- s = sum n: mint(_,n).
totalSupply(n) :- constructor(_, init), allMint(m), n := init+m.

// Allowance: entry+sentinel pattern
allowanceParticipant(o, s) :- increaseAllowance(o, s, _).
allowanceParticipant(o, s) :- transferFrom(o, _, s, _).
allowanceEntry(o, s, n) :- increaseAllowance(o, s, n).
allowanceEntry(o, s, 0) :- allowanceParticipant(o, s).
spentEntry(o, s, n)     :- transferFrom(o, _, s, n).
spentEntry(o, s, 0)     :- allowanceParticipant(o, s).
allowanceTotal(o, s, m) :- allowanceEntry(o, s, _), m = sum n: allowanceEntry(o, s, n).
spentTotal(o, s, m)     :- spentEntry(o, s, _),     m = sum n: spentEntry(o, s, n).
allowance(o, s, n) :- allowanceTotal(o, s, m), spentTotal(o, s, l), n := m-l.

// Match initial totalBalances to initial totalSupply to avoid false-positive unequalBalance
totalBalances(s) :- constructor(_, s).
totalBalances(s) :- s = sum n: balanceOf(_,n).
