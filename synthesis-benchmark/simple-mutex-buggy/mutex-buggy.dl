// Buggy Mutual Exclusion Test for BMC  
// BUG: withdraw guard is wrong - uses <= instead of >=

.decl constructor()

// State
.decl *raised(n: uint)
.decl *target(n: uint)

// Track operations
.decl *onceWithdraw(b: bool)
.decl *onceRefund(b: bool)

// Transactions
.decl recv_withdraw()
.decl withdraw()
.decl recv_refund()
.decl refund()

// Interfaces
.public recv_withdraw
.public recv_refund
.public raised(0)
.public target(0)
.public onceWithdraw(0)
.public onceRefund(0)

// Constructor
raised(5000) :- constructor().
target(10000) :- constructor().
onceWithdraw(false) :- constructor().
onceRefund(false) :- constructor().

// Transaction: withdraw - BUG! Should be r >= t, but uses r <= t
// This allows withdraw when it should only allow refund
withdraw() :- recv_withdraw(), raised(r), target(t), r <= t.

// Transaction: refund - correct: allowed when raised < target  
refund() :- recv_refund(), raised(r), target(t), r < t.

// Track that operations occurred
onceWithdraw(true) :- withdraw().
onceRefund(true) :- refund().

// VIOLATION: Both withdraw and refund should never occur
// With the bug above, both conditions can be true when r < t
// (since r < t implies r <= t)
.decl *bothOperations()
.violation bothOperations

bothOperations() :- onceWithdraw(true), onceRefund(true).



