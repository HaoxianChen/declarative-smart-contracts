// Buggy Wallet Contract - Allows Repeat Withdrawal
// Similar to auction.dl but with intentional bug

.decl *owner(p: address)
.decl constructor()

// Constructor
owner(s) :- constructor(), msgSender(s).

// Transactions
.decl recv_withdraw()
.decl withdraw(p: address, amount: uint)

// Interface
.public recv_withdraw

// Transaction: withdraw - BUG: no check to prevent repeat withdrawals
// Correct version: should track and limit to 1 withdrawal per address
// Buggy version: allows unlimited withdrawals
withdraw(p, 50) :- recv_withdraw(), msgSender(p).

send(p, 50) :- withdraw(p, 50).

// Track withdrawal count per address
.decl withdrawCount(p: address, c: uint)[0]
withdrawCount(p, c) :- withdraw(p, _), c = count: withdraw(p, _).

// VIOLATION: Should never withdraw more than once
.decl *repeatWithdraw(p: address, c: uint)[0]
.violation repeatWithdraw

repeatWithdraw(p, c) :- withdrawCount(p, c), c > 1.
