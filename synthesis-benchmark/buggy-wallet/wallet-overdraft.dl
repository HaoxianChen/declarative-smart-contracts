// Buggy Wallet Contract - Allows Overdraft
// BUG: Missing balance check in withdraw, allowing negative balance

.decl constructor()

// State
.decl *balance(n: uint)
.decl deposits(p: address, n: uint)[0]

// Transactions
.decl recv_deposit()
.decl deposit(p: address, amount: uint)
.decl recv_withdraw()
.decl withdraw(p: address, amount: uint)

// Interfaces
.public recv_deposit
.public recv_withdraw
.public balance(0)

// Constructor
balance(0) :- constructor().

// Transaction: deposit - always allowed
deposit(p, amount) :- recv_deposit(), msgSender(p), msgValue(amount), amount >= 0.

// Update deposits
.decl depositTotal(p: address, n: uint)[0]
depositTotal(p, total) :- deposit(p, _), total = sum amount: deposit(p, amount).
deposits(p, n) :- depositTotal(p, n).

// Update balance
balance(total) :- total = sum amount: deposit(_, amount).

// Transaction: withdraw - BUG! Should check balance >= amount
// Buggy version: no balance check, always allows withdrawal
withdraw(p, amount) :- recv_withdraw(), msgSender(p), msgValue(amount), amount >= 0, balance(bal), bal > 0.

send(p, amount) :- withdraw(p, amount).

// VIOLATION: Balance should never be negative
// With deposits and withdrawals, we compute net balance
.decl *withdrawTotal(n: uint)
.decl *netBalance(n: uint)

withdrawTotal(total) :- withdraw(_, _), total = sum amount: withdraw(_, amount).
netBalance(net) :- balance(bal), withdrawTotal(w), net := bal - w.

.decl *negativeBalance(n: uint)
.violation negativeBalance

// Violation when net balance is negative (balance < withdrawals)
negativeBalance(net) :- balance(bal), withdrawTotal(w), bal < w, net := bal - w.




