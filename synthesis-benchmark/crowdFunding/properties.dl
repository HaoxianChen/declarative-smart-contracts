// total balance should be equal to raised amount when crowdfunding is still open
missingFund(m,r) :- totalBalance(m),raised(r),m!=r,closed(b), b==false.

// cannot both refund and withdraw in the same execution
refundAndWithdraw() :- onceWithdraw(true), onceRefund(true).

// cannot refund if target is met
illegalRefund() :- onceRefund(true), raised(r), target(t), r>=t.

// no negative balances (refundTotal exceeds investTotal)
negativeBalance(p) :- investTotal(p,i), refundTotal(p,r), r>i.

// authority rules (retain recv_tx)
closeNotByOwner() :- recv_close(), owner(o), msgSender(s), s!=o.
withdrawNotByBeneficiary() :- recv_withdraw(p,_), beneficiary(b), p!=b.

// lifecycle (once sentinel)
investAfterClose() :- onceInvestAfterClose(b), b==true.
withdrawBeforeTarget() :- onceWithdrawBeforeTarget(b), b==true.
refundBeforeClose() :- onceRefundBeforeClose(b), b==true.
