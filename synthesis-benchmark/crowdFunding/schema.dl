// source: https://github.com/eth-sri/verx-benchmarks/blob/master/overview/main.sol
// Relation declarations
.decl *target(t: uint)
.decl *beneficiary(p: address)
.decl *owner(p: address)
.decl *raised(n: uint)
.decl constructor(t: uint, b: address)

// Transactions
.decl recv_close()
.decl close()
.decl recv_invest(p: address, n: uint > 0)
.decl invest(p: address, n: uint)
.decl recv_refund(p: address, n: uint > 0)
.decl refund(p: address, n: uint)
.decl recv_withdraw(p: address, n: uint > 0)
.decl withdraw(p: address, n: uint)

.decl *closed(b: bool)

// Interfaces
.public recv_close
.public recv_invest
.public recv_refund
.public recv_withdraw
.public closed(0)
.public raised(0)
.public target(0)


// Views

.decl investTotal(p: address, n: uint)[0]
.decl refundTotal(p: address, n: uint)[0]
.decl balanceOf(p: address, n: uint)[0]
.public balanceOf(1)

// Properties
.decl *missingFund(m:uint, r:uint)
.violation missingFund
.decl *totalBalance(m:uint)

.decl *onceWithdraw(b: bool)
.decl *onceRefund(b: bool)

.decl *refundAndWithdraw()
.violation refundAndWithdraw

.decl *illegalRefund()
.violation illegalRefund

.decl negativeBalance(p: address)
.violation negativeBalance

.decl closeNotByOwner()
.violation closeNotByOwner

.decl *onceInvestAfterClose(b: bool)
.decl *onceWithdrawBeforeTarget(b: bool)
.decl *onceRefundBeforeClose(b: bool)

.decl investAfterClose()
.violation investAfterClose

.decl withdrawNotByBeneficiary()
.violation withdrawNotByBeneficiary

.decl withdrawBeforeTarget()
.violation withdrawBeforeTarget

.decl refundBeforeClose()
.violation refundBeforeClose

.decl invalidTx()
.violation invalidTx

// Transaction placeholder rules
invest(p,n) :- recv_invest(p,n).
close() :- recv_close().
refund(p,n) :- recv_refund(p,n).
withdraw(p,r) :- recv_withdraw(p,r).
