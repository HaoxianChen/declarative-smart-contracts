// total balances equal total supply
unequalBalance(s,n) :- totalBalances(s), totalSupply(n), s!=n.

// no negative balances or allowances
negativeBalance(p,n) :- balanceOf(p,n), n<0, p!=0.
negativeAllowance(s,p,n) :- allowance(s,p,n), n<0, s!=0, p!=0.

// authority rules (retain recv_tx)
illegalRedeem(p,n) :- recv_controllerRedeem(p,n), controller(c), msgSender(s), s!=c.
illegalControllerTransfer() :- recv_controllerTransfer(_,_,_), controller(c), msgSender(s), s!=c.
