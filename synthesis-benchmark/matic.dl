// Adopted form Etherscan: https://etherscan.io/token/0xB8c77482e45F1F44dE1745F52C74426C631bDD52#code

// parameters
.decl *owner(p: address)

// views
.decl *totalSupply(n: int)
.decl balanceOf(p: address, n: int)[0]
.decl constructor(n: int)

// New views
.decl allowance(p: address, s: address, n:int)[0,1]
.decl *paused(b:bool)


// Transactions
.decl mint(p: address, amount: int)
.decl recv_mint(p: address, amount: int)
.decl burn(p: address, amount: int)
.decl recv_burn(p: address, amount: int)
.decl transfer(s: address, r: address, n: int)
.decl recv_transfer(s: address, r: address, n: int)

// New transactions
.decl recv_transferFrom(o: address, r: address, s: address, n: int)
.decl increaseAllowance(p: address, s: address, n:int)
// .decl recv_approve(s: address, n:int)

.decl isPauser(p: address, b: bool)[0]
// .decl recv_addPauser(p:address)
// .decl recv_renouncePauser()
//
// isPauser(p,true) :- recv_addPauser(p), msgSender(s), isPauser(s,b), b==true.
// isPauser(s,false) :- recv_renouncePauser(), msgSender(s), isPauser(s,b), b==true.
//
.decl recv_pause()
.decl recv_unpause()
.decl pause()
.decl unpause()
pause() :- recv_pause(). //, msgSender(s), isPauser(s,true), paused(false).
unpause() :- recv_unpause(). //, msgSender(s), isPauser(s,true), paused(true).

paused(true) :- pause().
paused(false) :- unpause().

.public recv_pause
.public recv_unpause
// .public recv_addPauser
// .public recv_renouncePauser

// Interfaces
.public recv_mint
.public recv_burn
.public recv_transfer
.public balanceOf(1)
.public totalSupply(0)
.public paused(0)

// New interfaces
// .public recv_approve
.public recv_transferFrom
.public allowance(2)

.decl totalMint(p: address, n: int)[0]
.decl totalBurn(p: address, n: int)[0]
.decl totalOut(p: address, n: int)[0]
.decl totalIn(p: address, n: int)[0]

.decl *allMint(n: int)
.decl *allBurn(n: int)

// Rules
owner(s) :- constructor(_), msgSender(s).
// totalSupply(n) :- constructor(n).
paused(false) :- constructor(_).
isPauser(s,true) :- constructor(_),msgSender(s).
// balanceOf(s,n) :- constructor(n),msgSender(s).
// totalMint(s,n) :- constructor(n),msgSender(s).
// allMint(n) :- constructor(n).

mint(p,n) :- recv_mint(p,n).
burn(p,n) :- recv_burn(p,n).
transfer(s,r,n) :- recv_transfer(s,r,n).

totalOut(p,s) :- transfer(p,_,_), s = sum n: transfer(p,_,n).
totalIn(p,s) :- transfer(_,p,_), s = sum n: transfer(_,p,n).
totalMint(p,s) :- mint(p,_), s = sum n: mint(p,n).
totalBurn(p,s) :- burn(p,_), s = sum n: burn(p,n).
balanceOf(p,s) :- totalMint(p,n), totalBurn(p,m), totalOut(p,o), totalIn(p,i), s:=n+i-m-o.

allMint(s) :- s = sum n: mint(_,n).
allBurn(s) :- s = sum n: burn(_,n).
totalSupply(n) :- allMint(m), allBurn(b), n := m - b.

// New rules
.decl transferFrom(o: address, r: address, s: address, n: int)
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n).
transfer(o,r,n) :- transferFrom(o,r,_,n).

.decl recv_increaseAllowance(p: address, s:address, n:int)
.decl recv_decreaseAllowance(p: address, s:address, n:int)
.decl decreaseAllowance(p: address, s: address, n:int)
.public recv_increaseAllowance
.public recv_decreaseAllowance

// increaseAllowance(o,s,d) :- recv_approve(s,n), msgSender(o), allowance(o,s,m), d:=n-m.
increaseAllowance(o,s,n) :- recv_increaseAllowance(o,s,n).
decreaseAllowance(o,s,n) :- recv_decreaseAllowance(o,s,n).

.decl allowanceTotal(o:address, s:address, m:int)[0,1]
.decl decreaseAllowanceTotal(o:address, s:address, m:int)[0,1]
.decl spentTotal(o:address, s:address, m:int)[0,1]
allowanceTotal(o,s,m) :- increaseAllowance(o,s,_), m = sum n: increaseAllowance(o,s,n).
decreaseAllowanceTotal(o,s,m) :- decreaseAllowance(o,s,_), m = sum n: decreaseAllowance(o,s,n).
spentTotal(o,s,m) :- transferFrom(o,_,s,_), m = sum n: transferFrom(o,_,s,n).

allowance(o,s,n) :- allowanceTotal(o,s,m), spentTotal(o,s,l), decreaseAllowanceTotal(o,s,d), n := m-l-d.

// Properties
.decl *totalBalances(m: int)
.decl *unequalBalance(s: int, n: int)

.violation unequalBalance

// totalBalances(n) :- constructor(n).
totalBalances(s) :- s = sum n: balanceOf(_,n).
unequalBalance(s,n) :- totalBalances(s), totalSupply(n), s!=n.

.decl negativeBalance(p:address,n:int)[0]
.violation negativeBalance
negativeBalance(p,n) :- balanceOf(p,n), n<0, p!=0.

.decl negativeAllowance(s:address,p:address,n:int)[0,1]
.violation negativeAllowance
negativeAllowance(s,p,n) :- allowance(s,p,n), n<0, s!=0, p!=0.

.decl invalidTx()
.violation invalidTx
invalidTx() :- paused(true), recv_transfer(_,_,_).
invalidTx() :- paused(true), recv_transferFrom(_,_,_,_).

