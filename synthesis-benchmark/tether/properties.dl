// balances should add up to totalSupply
unequalBalance(s,n) :- totalBalances(s), totalSupply(n), s!=n.

// no negative balances or allowances
negativeBalance(p,n) :- balanceOf(p,n), n<0, p!=0.
negativeAllowance(s,p,n) :- allowance(s,p,n), n<0, s!=0, p!=0.

// authority rules (retain recv_tx)
unauthorizedIssue() :- recv_issue(_,_), owner(o), msgSender(s), s!=o.
unauthorizedRedeem() :- recv_redeem(_,_), owner(o), msgSender(s), s!=o.
unauthorizedDestroyBlackFund() :- recv_destroyBlackFund(_,_), owner(o), msgSender(s), s!=o.
unauthorizedAddBlackList() :- recv_addBlackList(_), owner(o), msgSender(s), o!=s.

// once sentinel for blacklisted transfers
blacklistedTransfer() :- onceBlacklistedTransfer(b), b==true.
