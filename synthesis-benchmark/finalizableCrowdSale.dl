// .violation endedAfterFinalize
// endedAfterFinalize() :- onceFinalize(true), now(t), end(e), t<e.


.decl negativeBalance(p:address,n:int)[0]
.violation negativeBalance
negativeBalance(p,n) :- balanceOf(p,n), n<0, p!=0.

.decl negativeAllowance(s:address,p:address,n:int)[0,1]
.violation negativeAllowance
negativeAllowance(s,p,n) :- allowance(s,p,n), n<0, s!=0, p!=0.

.decl invalidTx()
.violation invalidTx
invalidTx() :- recv_mint(_,_), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_burn(_,_), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_finalize(), owner(o), msgSender(s), o!=s.
invalidTx() :- recv_finalize(), now(t), end(e), t<e.
invalidTx() :- recv_buyToken(_,_), now(t), start(s), t<s.
invalidTx() :- recv_buyToken(_,_), now(t), end(e), t>e.
