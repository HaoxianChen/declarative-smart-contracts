// no negative balances or allowances
negativeBalance(p,n) :- balanceOf(p,n), n<0, p!=0.
negativeAllowance(s,p,n) :- allowance(s,p,n), n<0, s!=0, p!=0.

// authority rules (retain recv_tx)
unauthorizedMint() :- recv_mint(_,_), owner(o), msgSender(s), o!=s.
unauthorizedBurn() :- recv_burn(_,_), owner(o), msgSender(s), o!=s.
unauthorizedFinalize() :- recv_finalize(), owner(o), msgSender(s), o!=s.

// once sentinel for buying outside sale period
buyOutsideSale() :- onceBuyOutsideSale(b), b==true.

// once sentinel for finalizing before end
finalizeBeforeEnd() :- onceFinalizeBeforeEnd(b), b==true.
