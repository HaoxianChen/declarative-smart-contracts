/**
  Example taken from Solidity documentation: https://docs.soliditylang.org/en/v0.8.7/solidity-by-example.html#simple-open-auction
 */

// Configs
.decl *owner(p: address)
.decl *beneficiary(p: address)
.decl *endTime(t: int)
.decl constructor(beneficiary: address, biddingTime: int)

// Constructor

// Transactions
.decl bid(bidder: address, amount: int)
.decl recv_bid(bidder: address, amount: int)
.decl withdraw(bidder: address)
.decl recv_withdraw(bidder: address)
.decl recv_withdrawWin(bidder: address)
.decl *end(b: bool)
.decl recv_endAuction()

// Interface
.public recv_bid
.public recv_withdraw
.public recv_withdrawWin
.public recv_endAuction

// Views
.decl *highestBid(bidder: address, amount: int)
.decl balance(p: address, n:int)[0]
.public balance(1)
.public highestBid(0)


.decl withdrawTotal(p: address, n:int)[0]
.decl bidTotal(p: address, n:int)[0]

// Transaction conditions
//            now(t1), endTime(t2), t1 < t2, end(false).

.decl withdrawCount(p:address, c:int)[0]



// Property
.decl repeatWithdraw(p:address,c:int)[0]
.violation repeatWithdraw

.decl negativeBalance(p:address,n:int)[0]
.violation negativeBalance

.decl invalidTx()
.violation invalidTx

.decl insufficientBalance(p:address,n:int)[0]
.violation insufficientBalance
