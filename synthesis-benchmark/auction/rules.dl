// ===== Constructor rules (state init) =====
owner(s) :-
    constructor(_,_),
    msgSender(s).

beneficiary(p) :-
    constructor(p,_).

endTime(t2) :-
    constructor(_,d),
    t2 := d.

end(false) :-
    constructor(_,_).

// Initialize highest bid state (split singleton)
highestBidder(1) :-
    constructor(_,_).

highestBidAmount(0) :-
    constructor(_,_).

// ===== Derived state =====
// NOTE: keep bidder/amount in separate singletons (avoids multi-field singleton).
highestBidAmount(m) :-
    bid(_, _),
    m = max n: bid(_,n).

highestBidder(p) :-
    bid(p,m),
    highestBidAmount(m).

end(true) :-
    endAuction().

// ===== Accounting =====
bidTotal(p,n) :-
    bid(p,_),
    n = sum m: bid(p,m).

withdrawTotal(p,n) :-
    withdraw(p,_),
    n = sum m: withdraw(p,m).

balance(p,n) :-
    bidTotal(p,b),
    withdrawTotal(p,w),
    n := b - w.

// Replace `count:` aggregator to avoid CountView bug in this repo.
withdrawUnit(p,1) :-
    withdraw(p,_).

withdrawCount(p,c) :-
    withdrawUnit(p,_),
    c = sum one: withdrawUnit(p,one).

// ===== Effects =====
send(p,n) :- withdraw(p,n).
send(p,n) :- endAuction(), highestBidAmount(n), beneficiary(p).