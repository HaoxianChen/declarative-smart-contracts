owner(s) :- constructor(_,_), msgSender(s).
totalSupply(0) :- constructor(_,_).
// mint(p,n) :- recv_mint(p,n), msgSender(s), owner(o), s==o, p!=0.
// burn(p,n) :- recv_burn(p,n), msgSender(s), owner(o), s==o, p!=0 ,balanceOf(p,m), n<=m.
// transfer(s,r,n) :- recv_transfer(s,r,n), msgSender(s), balanceOf(s,m), n<=m.
mint(p,n) :- recv_mint(p,n).
burn(p,n) :- recv_burn(p,n).
transfer(s,r,n) :- recv_transfer(s,r,n).
totalOut(p,s) :- transfer(p,_,_), s = sum n: transfer(p,_,n).
totalIn(p,s) :- transfer(_,p,_), s = sum n: transfer(_,p,n).
totalMint(p,s) :- mint(p,_), s = sum n: mint(p,n).
totalBurn(p,s) :- burn(p,_), s = sum n: burn(p,n).
balanceOf(p,s) :- totalMint(p,n), totalBurn(p,m), totalOut(p,o), totalIn(p,i), s:=n+i-m-o.
allMint(s) :- s = sum n: mint(_,n).
allBurn(s) :- s = sum n: burn(_,n).
totalSupply(n) :- allMint(m), allBurn(b), n := m - b.
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n).
transfer(o,r,n) :- transferFrom(o,r,_,n).
// approve(o,s,d) :- recv_approve(o,s,n), msgSender(o).
// increaseAllowance(o,s,d) :- approve(o,s,n), msgSender(o), allowance(o,s,m), d:=n-m.
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d).
allowanceTotal(o,s,m) :- increaseAllowance(o,s,_), m = sum n: increaseAllowance(o,s,n).
spentTotal(o,s,m) :- transferFrom(o,_,s,_), m = sum n: transferFrom(o,_,s,n).
allowance(o,s,n) :- allowanceTotal(o,s,m), spentTotal(o,s,l), n := m-l.
rate(r) :- constructor(_,r), r>0.
buyToken(p,m) :- recv_buyToken(p,m).
mint(p,n) :- buyToken(p,m), rate(r), n:=m*r.
raised(s) :- s = sum n: buyToken(_,n).
cap(c) :- constructor(c,_), c>0.
// finalize() :- recv_finalize(), msgSender(s), owner(o), s==o, finalized(f), f==false, now(t), end(e), t>e.
// finalize() :- recv_finalize(), msgSender(s), owner(o), s==o, finalized(f), f==false, raised(m), cap(c), m>=c.
finalize() :- recv_finalize().
finalized(true) :- finalize().
onceFinalize(false) :- constructor(_,_).
onceFinalize(true) :- finalize().
// illegalFinalization() :- onceFinalize(true), now(t), end(e), t<e, raised(r), cap(c), r<c.
