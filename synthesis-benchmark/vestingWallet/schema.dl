// Transactions / derived releases
.decl recv_release()
.decl release()                  // tx trigger
.public recv_release

.decl releaseAmount(n: uint)      // derived payout amount (per release call)
.decl *released(n: uint)
.public released(0)

// State
.decl *beneficiary(p: address)
.decl *start(t:uint)
.decl *duration(t:uint)
.decl *funds(b: uint)            // abstract total funds to vest (compile-only)

.decl constructor(s: uint, d:uint, b:address)

// UDF: proportional vesting schedule (mirrors _vestingSchedule in the original contract)
.decl vestedAmount(totalAlloc: uint, elapsed: uint, amount: uint)
.udf vestedAmount

// Properties (preserve original)
.decl *earlyRelease(e: uint)
.violation earlyRelease

.decl invalidTx()
.violation invalidTx

// Transaction placeholder rules
// Make the tx trigger rule semantically meaningful (and avoid synthesis "disabling" the tx):
// only allow calling release when it can actually release a positive amount.
release() :-
  recv_release(),
  now(t),
  start(a),
  duration(d),
  funds(b),
  released(e),
  total := b + e,
  elapsed := t - a,
  vestedAmount(total, elapsed, vested),
  t>a+d,
  b>e,
  vested>e.

