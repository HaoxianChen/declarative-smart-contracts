// Preserve original property: early release is not allowed
earlyRelease(e) :- released(e), now(t), start(a), t<a, e > 0.

////////////////////
// Transaction validity
////////////////////

// Domain guard : for uint state like released(e), disallow negative models.
// This steers synthesis away from guards like `released_n < 0` which are impossible in Solidity uint.
invalidTx() :- recv_release(), released(e), e < 0.

// disallow calling release before start
invalidTx() :- recv_release(), now(t), start(a), t<a.
invalidTx() :- recv_release(), now(t), start(a), duration(d), t<=a+d.
invalidTx() :- recv_release(), funds(b), released(e), b<=e.

// release is invalid when the vested amount does not exceed what has already been released
invalidTx() :-
  recv_release(),
  released(e), funds(b), now(t), start(a),
  total := b + e,
  elapsed := t - a,
  vestedAmount(total, elapsed, vested),
  vested <= e.

