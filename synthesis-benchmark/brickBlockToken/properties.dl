// (removed: sentinel-based transferBeforeUnpause and evacuateAfterUpgrade)

// should not have negative balance or allowance
negativeBalance(p,n) :- balances(p,n), n<0, p!=0.
negativeAllowance(s,p,n) :- allowed(s,p,n), n<0, s!=0, p!=0.

// authority rules (retain recv_tx)
unauthorizedPause() :- recv_pause(), owner(o), msgSender(s), s!=o.
unauthorizedUnpause() :- recv_unpause(), owner(o), msgSender(s), s!=o.
unauthorizedUpgrade() :- recv_upgrade(_), owner(o), msgSender(s), s!=o.
unauthorizedMint() :- recv_mint(_,_), owner(o), msgSender(s), s!=o.
evacuateNotByOwner() :- recv_evacuate(_), owner(o), msgSender(s), s!=o.
