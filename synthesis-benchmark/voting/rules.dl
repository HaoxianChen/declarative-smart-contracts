// Initialization
hasWinner(false) :- constructor().
quorumSize(1) :- constructor().
winningProposal(0) :- constructor().

// Minimal voter initialization (Scheme A):
// Make the deployer (constructor msgSender) a valid voter so vote() is reachable.
isVoter(v, true) :- constructor(), msgSender(v).

// Voting — include voter address in voteUnit so each voter contributes a distinct tuple
voteUnit(v,p,1) :- vote(v,p).
votes(p,c) :- voteUnit(_,p,_), c = sum one: voteUnit(_,p,one).

// Finalize: materialize winner state
wins(p, true) :- finalize(p), votes(p,c), quorumSize(q), c >= q.
hasWinner(true) :- finalize(p), votes(p,c), quorumSize(q), c >= q.
winningProposal(p) :- finalize(p), votes(p,c), quorumSize(q), c >= q.

voted(v,true) :- vote(v,_).

