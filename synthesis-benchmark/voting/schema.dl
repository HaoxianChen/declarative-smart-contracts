// Constructor
.decl constructor()

// Vote interface + tx 
.decl recv_vote(v: address, proposal: uint)
.decl vote(v: address, proposal: uint)
.public recv_vote

// Finalize interface + tx
.decl recv_finalize(proposal: uint)
.decl finalize(proposal: uint)
.public recv_finalize

// State / views
.decl isVoter(v: address, b: bool)[0]
.public isVoter(1)

// NOTE: avoid `count:` aggregator (it crashes ImperativeTranslator/CountView in this repo).
// Model votes count as int via summation over a derived unit relation.
.decl voteUnit(proposal: uint, one: int)[0]
.decl votes(proposal: uint, c: int)[0]
.public votes(1)
.decl wins(proposal: uint, b: bool)[0]
.public wins(1)
.decl voted(p: address, b: bool)[0]
.public voted(1)
.decl *winningProposal(proposal: uint)
.public winningProposal(0)

.decl *hasWinner(b: bool)
.public hasWinner(0)

.decl *quorumSize(q: int)

// Properties
.decl inconsistency(p1: uint, p2: uint)[0,1]
.violation inconsistency

.decl invalidTx()
.violation invalidTx

// Transaction placeholder rule
vote(v,p) :- recv_vote(v,p).

// Transaction placeholder rule (finalize)
finalize(p) :- recv_finalize(p).