.decl *_wallet(p:address)
.decl *_weiRaised(a:uint)
.decl *_openingTime(a:uint)
.decl *_closingTime(a:uint)
.decl *_finalized(b:bool)

.decl *_primary(p:address)
.decl _deposits(p:address, a:uint)[0]
.public _deposits(1)

.decl *state(a:uint)
.decl *_beneficiary(p:address)
.decl *_goal(a:uint)
.decl *_cap(a:uint)

.decl *totalSupply(n: uint)
.decl balanceOf(p: address, n: uint)[0]
.decl allowance(p: address, s: address, n:uint)[0,1]

.decl constructor(t1:uint, t2:uint, p:address, cap:uint, goal:uint)
_finalized(false) :- constructor(_,_,_,_,_).
_primary(s) :- constructor(_,_,_,_,_), msgSender(s).
state(0) :- constructor(_,_,_,_,_).
_wallet(p) :- constructor(_,_,p,_,_).
_goal(a) :- constructor(_,_,_,n,a), a<=n.
_cap(n) :- constructor(_,_,_,n,a), a<=n.
totalSupply(0) :- constructor(_,_,_,_,_).
_openingTime(t1) :- constructor(t1,_,_,_,_).
_closingTime(t2) :- constructor(_,t2,_,_,_).

_beneficiary(p) :- _wallet(p).

//// erc20 Transactions
.decl mint(p: address, amount: uint)
.decl recv_mint(p: address, amount: uint)
.decl burn(p: address, amount: uint)
.decl recv_burn(p: address, amount: uint)
.decl transfer(from: address, to: address, amount: uint)
.decl recv_transfer(to: address, amount: uint)
.decl recv_transferFrom(from: address, to: address, amount: uint)
.decl increaseAllowance(p: address, s: address, n:uint)
.decl recv_approve(s: address, n:uint)

.public recv_mint
.public recv_burn
.public recv_transfer
.public balanceOf(1)
.public totalSupply(0)
.public recv_approve
.public recv_transferFrom
.public allowance(2)

mint(p,n) :- recv_mint(p,n), p!=0.
burn(p,n) :- recv_burn(p,n), p!=0 ,balanceOf(p,m), n<=m.
transfer(s,r,n) :- recv_transfer(r,n), msgSender(s), balanceOf(s,m), n<=m.

.decl totalMint(p: address, n: uint)[0]
.decl totalBurn(p: address, n: uint)[0]
.decl totalOut(p: address, n: uint)[0]
.decl totalIn(p: address, n: uint)[0]
totalOut(p,s) :- transfer(p,_,_), s = sum n: transfer(p,_,n).
totalIn(p,s) :- transfer(_,p,_), s = sum n: transfer(_,p,n).
totalMint(p,s) :- mint(p,_), s = sum n: mint(p,n).
totalBurn(p,s) :- burn(p,_), s = sum n: burn(p,n).
balanceOf(p,s) :- totalMint(p,n), totalBurn(p,m), totalOut(p,o), totalIn(p,i), s:=n+i-m-o.

.decl *allMint(n: uint)
.decl *allBurn(n: uint)
allMint(s) :- s = sum n: mint(_,n).
allBurn(s) :- s = sum n: burn(_,n).
totalSupply(n) :- allMint(m), allBurn(b), n := m - b.

.decl transferFrom(from: address, to: address, spender: address, amount: uint)
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,n),
                    balanceOf(o,m), m>=n,
                    msgSender(s), allowance(o,s,k), k>=n.
transfer(o,r,n) :- transferFrom(o,r,_,n).

increaseAllowance(o,s,d) :- recv_approve(s,n), msgSender(o), allowance(o,s,m), d:=n-m.

.decl allowanceTotal(o:address, s:address, m:uint)[0,1]
.decl spentTotal(o:address, s:address, m:uint)[0,1]
allowanceTotal(o,s,m) :- increaseAllowance(o,s,_), m = sum n: increaseAllowance(o,s,n).
spentTotal(o,s,m) :- transferFrom(o,_,s,_), m = sum n: transferFrom(o,_,s,n).

allowance(o,s,n) :- allowanceTotal(o,s,m), spentTotal(o,s,l), n := m-l.


//// RefundEscrow
.decl recv_transferPrimary(p:address)
.public recv_transferPrimary
.decl transferPrimary(p:address)
transferPrimary(p) :- recv_transferPrimary(p), p!=0, msgSender(s), _primary(s).
_primary(p) :- transferPrimary(p).

.decl recv_deposit(p:address)
.public recv_deposit
.decl deposit(p:address, a:uint)
deposit(p,a) :- recv_deposit(p), msgSender(s), _primary(s), msgValue(a), state(h), h==0.
_deposits(p,s) :- deposit(p,_), s = sum n: deposit(p,n).

.decl recv_withdraw(p:address)
.public recv_withdraw
.decl withdraw(p:address)
withdraw(p) :- recv_withdraw(p), msgSender(s), _primary(s).
_deposits(p,a) :- withdraw(p), a:=0.


////   SampleCrowdsale
.decl recv_buyToken(p:address)
.public recv_buyToken
.decl buyToken(a:uint, p:address)
buyToken(v,p) :- recv_buyToken(p), msgValue(v), p!=0, v!=0, _weiRaised(r),_cap(c),r<=c.
//            Now(t), t>=_openingTime, t<=_closingTime,

mint(p,n) :- buyToken(n,p).
deposit(p,n) :- buyToken(n,p).

.decl raised(a:uint)
raised(a) :- buyToken(a,_).
_weiRaised(s) :- raised(_), s = sum n: raised(n).

/// crowdsale finalize
.decl recv_finalize()
.public recv_finalize
.decl finalize()
finalize() :- recv_finalize(), _finalized(false).
            //Now(t), t>_closingTime.
_finalized(true) :- finalize(). 

/// escrow finalize
.decl finalization()
finalization() :- finalize().

.decl closeEscrow()
closeEscrow() :- finalization(), _goal(a), _weiRaised(n), n>=a, msgSender(s), _primary(s), state(h), h==0.
state(2) :- closeEscrow(). 

.decl enableRefunds()
enableRefunds() :- finalization(), _goal(a), _weiRaised(n), n<a, msgSender(s), _primary(s), state(h), h==0.
state(1) :- enableRefunds().


.decl recv_claimRefund(p:address)
.public recv_claimRefund
.decl claimRefund(p:address)
claimRefund(p) :- recv_claimRefund(p), _finalized(true), _weiRaised(s), _goal(g),s<g.




//// Properties
//always((SampleCrowdsale._weiRaised <= SampleCrowdsale._cap));
.decl *moreThanCap(b:bool)
.violation moreThanCap

moreThanCap(true) :- _weiRaised(n), _cap(m), n>m.

//always((SampleCrowdsale._wallet == RefundEscrow._beneficiary) 
//            && (SampleCrowdsale._wallet == 0x5555555555555555555555555555555555555555));

.decl *notSame(b:bool)
.violation notSame

notSame(true) :- _wallet(p), _beneficiary(p2), p!=p2.





