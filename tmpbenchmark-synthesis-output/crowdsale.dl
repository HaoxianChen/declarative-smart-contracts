increaseAllowance(o,s,n) :- recv_increaseAllowance(o,s,n),balanceOf(s,balanceOf_x1),0!=balanceOf_x1.
deposit(p,a) :- a!=0,recv_deposit(p,a),p!=address(0),balanceOf(p,balanceOf_x1),state(h_1),balanceOf_x1>0,h_1==0.
finalize() :- t_3>=c_3,_closingTime(c_3),h_1==0,state(h_1),b_2!=true,msgSender(s_0),recv_finalize(),_primary(p_0),_finalized(b_2),s_0==p_0,now(t_3).
transferFrom(o,r,sp,n) :- n>0,allowance(o,sp,k_2),r!=address(0),n<=m_0,recv_transferFrom(o,r,sp,n),balanceOf(o,m_0),n<=k_2,o!=address(0).
buyToken(p,v) :- state(h_3),t_5<=c_5,balanceOf(p,balanceOf_x1),_weiRaised(r_1),now(t_2),recv_buyToken(p,v),_finalized(b_4),_closingTime(c_5),t_2>=o_2,now(t_5),_openingTime(o_2),p!=address(0),h_3==0,b_4!=true,balanceOf_x1>0,_cap(c_1),r_1<=c_1,v!=0.
transfer(s,r,n) :- s!=address(0),r!=address(0),n<=m_1,balanceOf(s,m_1),recv_transfer(s,r,n),n>0.
claimRefund(p) :- _finalized(b_3),recv_claimRefund(p),state(h_2),r_0<g_0,_deposits(p,a_1),b_3!=false,_weiRaised(r_0),_goal(g_0),a_1!=0,h_2==1.
mint(p,n) :- recv_mint(p,n),balanceOf(p,balanceOf_x1),p!=address(0),balanceOf_x1>0.
transferPrimary(p) :- recv_transferPrimary(p),balanceOf(p,balanceOf_x1),balanceOf_x1>0.
withdraw(p) :- recv_withdraw(p),balanceOf(p,balanceOf_x1),balanceOf_x1>0.
burn(p,n) :- n>0,p!=address(0),balanceOf(p,m_1),n<=m_1,recv_burn(p,n).