transferFrom(o,r,sp,n) :- n>0,allowance(o,sp,k_2),r!=address(0),n<=m_0,sp!=address(0),recv_transferFrom(o,r,sp,n),balanceOf(o,m_0),n<=k_2,o!=address(0).
transferPrimary(p) :- _primary(p_1),p!=address(0),recv_transferPrimary(p),balanceOf_x1>0,s_1==p_1,balanceOf(p,balanceOf_x1),msgSender(s_1).
burn(p,n) :- n>0,p!=address(0),balanceOf(p,m_1),n<=m_1,recv_burn(p,n).
claimRefund(p) :- h_2==1,_finalized(b_3),recv_claimRefund(p),state(h_2),_goal(g_1),a_0!=0,s_1<g_1,b_3!=false,_deposits(p,a_0),_weiRaised(s_1).
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d),balanceOf(s,balanceOf_x1),d>=0,d<balanceOf_x1.
transfer(s,r,n) :- s!=address(0),r!=address(0),n<=m_1,balanceOf(s,m_1),recv_transfer(s,r,n),n>0.
withdraw(p) :- msgSender(s),recv_withdraw(p),_primary(p),balanceOf(p,balanceOf_x1),s==p,balanceOf_x1>0.
mint(p,n) :- recv_mint(p,n),balanceOf(p,balanceOf_x1),p!=address(0),balanceOf_x1>0.
buyToken(p,v) :- state(h_3),t_5<=c_5,balanceOf(p,balanceOf_x1),_weiRaised(r_1),now(t_2),recv_buyToken(p,v),v!=0,_finalized(b_4),_closingTime(c_5),r_1+v<=c_1,t_2>=o_2,now(t_5),_openingTime(o_2),p!=address(0),h_3==0,b_4!=true,balanceOf_x1>0,_cap(c_1).
finalize() :- t_3>=c_3,_closingTime(c_3),h_1==0,state(h_1),b_2!=true,msgSender(s_0),recv_finalize(),_primary(p_0),_finalized(b_2),s_0==p_0,now(t_3).
deposit(p,a) :- a!=0,_primary(p_1),recv_deposit(p,a),state(h_2),p!=address(0),balanceOf_x1>0,s_1==p_1,h_2==0,balanceOf(p,balanceOf_x1),msgSender(s_1).