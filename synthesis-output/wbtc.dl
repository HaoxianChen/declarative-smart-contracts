increaseApproval(o,s,n) :- recv_increaseApproval(o,s,n),n>0.
claimOwnership(p) :- recv_claimOwnership(p),pendingOwner(expected_0),pendingOwner(expected_1),s_0==expected_0,p==expected_1,msgSender(s_0).
decreaseApproval(o,s,n) :- recv_decreaseApproval(o,s,n),totalSupply(totalSupply_n),0!=totalSupply_n.
paused(true) :- recv_pause(),owner(o),msgSender(s),s==o.
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n),allowance(o,s,allowance_x2),n<=allowance_x2.
mint(p,n) :- msgSender(s),n>0,recv_mint(p,n),owner(o),s==o.
transfer(s,r,n) :- recv_transfer(s,r,n).
burn(p,n) :- recv_burn(p,n),balanceOf(p,balanceOf_x1),n<=balanceOf_x1.
paused(false) :- recv_unpause(),owner(o),msgSender(s),s==o.
transferOwnership(p) :- recv_transferOwnership(p),owner(o),msgSender(s),s==o.