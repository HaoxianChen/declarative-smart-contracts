buyToken(p,m) :- end(e_2),p!=address(0),recv_buyToken(p,m),start(s_1),now(t_2),m>0,now(t_1),t_1>=s_1,t_2<=e_2.
burn(p,n) :- msgSender(s),n<0,o==s,owner(o),recv_burn(p,n).
transfer(s,r,n) :- recv_transfer(s,r,n),0==n.
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d),d>=0.
finalize() :- recv_finalize(),start(start_time),0!=start_time.
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n),0==n.
mint(p,n) :- msgSender(s),recv_mint(p,n),o==s,owner(o),n>=0.