isApprovedForAll(owner,op,b) :- op!=address(0),msgSender(s_1),recv_setApprovalForAll(owner,op,b,_),owner==s_1,owner!=op.
ownerOf(tokenId,to) :- recv_transfer(_,to,tokenId,_,_),to!=address(0).
exists(tokenId,true) :- to!=address(0),op!=address(0),from!=address(0),recv_transferFrom(from,to,tokenId,op,prevApproved,t),op==s_1,msgSender(s_1).
ownerOf(tokenId,address(0)) :- recv_burn(tokenId,_,_,_),owner(o),msgSender(s),o==s.
exists(tokenId,true) :- recv_transfer(_,_,tokenId,_,_).
ownerOf(tokenId,to) :- o_1==s_1,to!=address(0),msgSender(s_1),owner(o_1),recv_mint(tokenId,to,_).
exists(tokenId,true) :- recv_mint(tokenId,_,_),owner(o),msgSender(s),o==s.
deltaBal(from,-1) :- o_1==s_1,from!=address(0),msgSender(s_1),recv_burn(_,from,_,_),owner(o_1).
approved(tokenId,prev,false) :- msgSender(s),prev!=address(0),o==s,owner(o),recv_burn(tokenId,_,prev,_).
deltaBal(to,1) :- o_1==s_1,to!=address(0),recv_mint(_,to,_),msgSender(s_1),owner(o_1).
ownerOf(tokenId,to) :- to!=address(0),op!=address(0),from!=address(0),recv_transferFrom(from,to,tokenId,op,prevApproved,t),op==s_1,msgSender(s_1).
deltaBal(to,1) :- recv_transfer(_,to,_,_,_),to!=address(0).
approved(tokenId,spender,b) :- recv_setApproval(tokenId,spender,b,_,_,_),spender!=address(0).
deltaBal(to,1) :- to!=address(0),op!=address(0),from!=address(0),recv_transferFrom(from,to,tokenId,op,prevApproved,t),op==s_1,msgSender(s_1).
exists(tokenId,false) :- recv_burn(tokenId,_,_,_),owner(o),msgSender(s),o==s.
approved(tokenId,prev,false) :- recv_setApproval(tokenId,_,_,_,prev,_),prev!=address(0).
deltaBal(from,-1) :- to!=address(0),op!=address(0),from!=address(0),recv_transferFrom(from,to,tokenId,op,prevApproved,t),op==s_1,msgSender(s_1).
approved(tokenId,prev,false) :- recv_transfer(_,_,tokenId,prev,_),prev!=address(0).
approved(tokenId,prev,false) :- to!=address(0),op!=address(0),from!=address(0),prev!=address(0),recv_transferFrom(from,to,tokenId,op,prev,t),op==s_1,msgSender(s_1).
deltaBal(from,-1) :- from==s_1,0!=balanceOf_x1,from!=address(0),recv_transfer(from,_,_,_,_),msgSender(s_1),balanceOf(from,balanceOf_x1).