ownerOf(tokenId,to) :- from!=address(0),msgSender(s_1),recv_transfer(_,to,tokenId,_,_),to!=address(0),from==s_1.
deltaBal(from,-1) :- from!=address(0),recv_transfer(from,_,_,_,_),msgSender(s_1),to!=address(0),from==s_1.
ownerOf(tokenId,to) :- to!=address(0),from!=address(0),recv_transferFrom(_,to,tokenId,_,_,_),op==s_1,msgSender(s_1).
deltaBal(from,-1) :- to!=address(0),from!=address(0),recv_transferFrom(from,_,_,_,_,_),op==s_1,msgSender(s_1).
deltaBal(to,1) :- from!=address(0),msgSender(s_1),recv_transfer(_,to,_,_,_),to!=address(0),from==s_1.
exists(tokenId,true) :- to!=address(0),recv_transferFrom(_,_,tokenId,_,_,_),from!=address(0),op==s_1,msgSender(s_1).
approved(tokenId,spender,b) :- recv_setApproval(tokenId,spender,b,_,_,_),msgSender(s_1),spender!=address(0),o==s_1.
approved(tokenId,prev,false) :- recv_transfer(_,_,tokenId,prev,_),from!=address(0),prev!=address(0),msgSender(s_1),to!=address(0),from==s_1.
ownerOf(tokenId,to) :- o_1==s_1,to!=address(0),msgSender(s_1),owner(o_1),recv_mint(tokenId,to,_).
deltaBal(to,1) :- to!=address(0),from!=address(0),recv_transferFrom(_,to,_,_,_,_),op==s_1,msgSender(s_1).
deltaBal(from,-1) :- o_1==s_1,from!=address(0),msgSender(s_1),recv_burn(_,from,_,_),owner(o_1).
exists(tokenId,false) :- o_1==s_1,from!=address(0),msgSender(s_1),recv_burn(tokenId,_,_,_),owner(o_1).
deltaBal(to,1) :- o_1==s_1,to!=address(0),recv_mint(_,to,_),msgSender(s_1),owner(o_1).
isApprovedForAll(owner,op,b) :- op!=address(0),o==s_1,msgSender(s_1),recv_setApprovalForAll(owner,op,b,_),o!=op.
approved(tokenId,prev,false) :- o==s_1,prev!=address(0),msgSender(s_1),spender!=address(0),recv_setApproval(tokenId,_,_,_,prev,_).
ownerOf(tokenId,address(0)) :- o_1==s_1,from!=address(0),msgSender(s_1),recv_burn(tokenId,_,_,_),owner(o_1).
approved(tokenId,prev,false) :- to!=address(0),from!=address(0),prev!=address(0),recv_transferFrom(_,_,tokenId,_,prev,_),op==s_1,msgSender(s_1).
exists(tokenId,true) :- o_1==s_1,to!=address(0),msgSender(s_1),recv_mint(tokenId,_,_),owner(o_1).
approved(tokenId,prev,false) :- o_1==s_1,from!=address(0),prev!=address(0),msgSender(s_1),recv_burn(tokenId,_,prev,_),owner(o_1).
exists(tokenId,true) :- from!=address(0),msgSender(s_1),to!=address(0),recv_transfer(_,_,tokenId,_,_),from==s_1.