evacuate(p) :- recv_evacuate(p),balances(msgSender,balances_x1),msgSender(msgSender),0!=balances_x1.
pause() :- recv_pause(),owner(o),msgSender(s),o==s.
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d),d>0.
mint(p,n) :- recv_mint(p,n),owner(o),msgSender(s),o==s.
upgrade(p) :- recv_upgrade(p).
transfer(s,r,n) :- paused(b_2),balances(s,m_1),recv_transfer(s,r,n),n>0,b_2!=true,n<=m_1.
transferFrom(s,f,r,n) :- recv_transferFrom(s,f,r,n),balances(f,m),n<=m.
unpause() :- recv_unpause(),owner(o),msgSender(s),o==s.
decreaseAllowance(o,s,d) :- recv_decreaseAllowance(o,s,d),balances(s,balances_x1),0!=balances_x1.