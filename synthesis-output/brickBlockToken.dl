mint(p,n) :- recv_mint(p,n),n>0.
transferFrom(s,f,r,n) :- recv_transferFrom(s,f,r,n),balances(f,balances_x1),0!=balances_x1.
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d),d>0.
pause() :- recv_pause().
decreaseAllowance(o,s,d) :- recv_decreaseAllowance(o,s,d),allowed(o,s,allowed_x2),d<=allowed_x2.
evacuate(p) :- recv_evacuate(p),balances(p,balances_x1),balances_x1>0.
upgrade(p) :- recv_upgrade(p).
unpause() :- recv_unpause().
transfer(s,r,n) :- recv_transfer(s,r,n),balances_x1>0,balances(r,balances_x1),paused(b),b!=true.