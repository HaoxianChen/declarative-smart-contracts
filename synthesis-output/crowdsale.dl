deposit(p,a) :- a!=0,p!=address(0),balanceOf(p,balanceOf_x1),h_1==0,state(h_1),recv_deposit(p,a),a<=balanceOf_x1.
transfer(s,r,n) :- recv_transfer(s,r,n),s!=address(0),r!=address(0),n<=m_1,balanceOf(s,m_1).
finalize() :- t_3>=c_3,_closingTime(c_3),h_1==0,state(h_1),b_2!=true,msgSender(s_0),recv_finalize(),_primary(p_0),_finalized(b_2),s_0==p_0,now(t_3).
mint(p,n) :- recv_mint(p,n),balanceOf(p,balanceOf_x1),p!=address(0),n<balanceOf_x1.
transferFrom(o,r,sp,n) :- allowance(o,sp,k_2),r!=address(0),n<=m_0,recv_transferFrom(o,r,sp,n),balanceOf(o,m_0),n<=k_2,o!=address(0).
burn(p,n) :- recv_burn(p,n),balanceOf(p,m_1),p!=address(0),n<=m_1.
withdraw(p) :- recv_withdraw(p),balanceOf(p,balanceOf_x1),balanceOf_x1>0.
increaseAllowance(o,s,n) :- recv_increaseAllowance(o,s,n),balanceOf(s,balanceOf_x1),n<=balanceOf_x1.
claimRefund(p) :- _finalized(b_3),recv_claimRefund(p),state(h_2),r_0<g_0,_deposits(p,a_1),b_3!=false,_weiRaised(r_0),_goal(g_0),a_1!=0,h_2==1.
buyToken(p,v) :- _finalized(b_3),_closingTime(c_4),_cap(c_6),p!=address(0),_openingTime(o_1),balanceOf_x1>0,b_3!=true,t_4<=c_4,recv_buyToken(p,v),v!=0,getTokenAmount(v,tokens_5),h_2==0,now(t_1),r_6<=c_6,tokens_5>0,state(h_2),now(t_4),balanceOf(p,balanceOf_x1),t_1>=o_1,_weiRaised(r_6).
transferPrimary(p) :- recv_transferPrimary(p),balanceOf(p,balanceOf_x1),balanceOf_x1>0.