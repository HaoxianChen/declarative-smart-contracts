transferFrom(o,r,sp,n) :- recv_transferFrom(o,r,sp,n),allowance(o,sp,allowance_x2),0!=allowance_x2.
mint(p,n) :- recv_mint(p,n),_deposits(msgSender,_deposits_x1),msgSender(msgSender),0!=_deposits_x1.
increaseAllowance(o,s,n) :- recv_increaseAllowance(o,s,n),0!=n.
finalize() :- recv_finalize(),_primary(p),msgSender(s),s==p.
deposit(p,a) :- recv_deposit(p,a),balanceOf(p,balanceOf_x1),a<=balanceOf_x1.
claimRefund(p) :- recv_claimRefund(p),_deposits(msgSender,_deposits_x1),msgSender(msgSender),0!=_deposits_x1.
transfer(s,r,n) :- recv_transfer(s,r,n),balanceOf(s,balanceOf_x1),n<=balanceOf_x1.
transferPrimary(p) :- msgSender(s),_deposits_x1>0,_deposits(msgSender,_deposits_x1),msgSender(msgSender),_primary(p),s==p,recv_transferPrimary(p).
buyToken(p,v) :- recv_buyToken(p,v).
withdraw(p) :- recv_withdraw(p),_deposits(msgSender,_deposits_x1),msgSender(msgSender),0!=_deposits_x1.
burn(p,n) :- recv_burn(p,n),balanceOf(p,balanceOf_x1),n<=balanceOf_x1.