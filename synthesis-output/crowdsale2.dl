buyToken(p,v) :- state(h_3),t_5<=c_5,_weiRaised(r_1),_cap(c_1),now(t_2),recv_buyToken(p,v),v!=0,_finalized(b_4),_closingTime(c_5),r_1+v<=c_1,t_2>=o_2,now(t_5),_openingTime(o_2),p!=address(0),h_3==0,b_4!=true.
burn(p,n) :- n>0,p!=address(0),balanceOf(p,m_1),n<=m_1,recv_burn(p,n).
claimRefund(p) :- h_2==1,_finalized(b_3),recv_claimRefund(p),state(h_2),_goal(g_1),a_0!=0,s_1<g_1,b_3!=false,_deposits(p,a_0),_weiRaised(s_1).
transfer(s,r,n) :- s!=address(0),r!=address(0),n<=m_1,balanceOf(s,m_1),recv_transfer(s,r,n),n>0.
