buyToken(p,v) :- tokens_5>0,_finalized(b_3),_closingTime(c_4),_cap(c_6),p!=address(0),r_6+v<=c_6,_openingTime(o_1),balanceOf_x1>0,b_3!=true,t_4<=c_4,recv_buyToken(p,v),v!=0,getTokenAmount(v,tokens_5),h_2==0,now(t_1),state(h_2),now(t_4),balanceOf(p,balanceOf_x1),t_1>=o_1,_weiRaised(r_6).
mint(p,n) :- recv_mint(p,n),balanceOf(p,balanceOf_x1),p!=address(0),n<balanceOf_x1.