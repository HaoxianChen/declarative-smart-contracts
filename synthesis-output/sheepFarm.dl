withdrawMoney(user,amount) :- recv_withdrawMoney(amount),amount>0,msgSender(msgSender),villageNeighbor(msgSender,villageNeighbor_x1),msgSender(user),villageNeighbor_x1==msgSender.
upgradeVillage(user,farm,sheep,y,c) :- getUpgradePrice(farm,sheep,c),msgSender(msgSender),villageNeighbor(msgSender,villageNeighbor_x1),getYield(farm,sheep,y),recv_upgradeVillage(farm,sheep),msgSender(user),villageNeighbor_x1==msgSender.
collectMoney(user,wool,t) :- msgSender(user),recv_collectMoney(),msgSender(msgSender),0!=villageGems_x1,now(t),villageGems(msgSender,villageGems_x1),syncYield(user,wool).
addGems(user,gems) :- recv_addGems(gems),gems>0,msgSender(msgSender),villageNeighbor(msgSender,villageNeighbor_x1),msgSender(user),villageNeighbor_x1==msgSender.
register(user,ref,10,t) :- msgSender(user),villageTimestamp(user,t),now(t),recv_register(ref),t==0.