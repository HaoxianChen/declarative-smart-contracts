freeze(p,n) :- recv_freeze(p,n),balanceOf(p,balanceOf_x1),n<=balanceOf_x1.
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d),d>=0.
mint(p,n) :- msgSender(s),recv_mint(p,n),o==s,owner(o),n>=0.
burn(p,n) :- owner(o_0),o_0==s_0,balanceOf(p,m_1),n<=m_1,msgSender(s_0),recv_burn(p,n).
withdrawEther(p,n) :- recv_withdrawEther(p,n),sendEther(p,n,success),success!=false.
transfer(s,r,n) :- s!=address(0),r!=address(0),n<=m_1,balanceOf(s,m_1),recv_transfer(s,r,n),n>0.
unfreeze(p,n) :- recv_unfreeze(p,n),n>=0.
transferFrom(o,r,s,n) :- n>0,allowance(o,s,allowance_x2),balanceOf(o,m_1),n<=allowance_x2,n<=m_1,recv_transferFrom(o,r,s,n).