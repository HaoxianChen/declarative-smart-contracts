transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n),totalSupply(totalSupply_n),n>0,0!=totalSupply_n.
setMinter(p) :- recv_setMinter(p),minter(m),msgSender(s),m==s.
mint(p,n) :- recv_mint(p,n),minter(m),msgSender(s),m==s.
transfer(s,r,n) :- recv_transfer(s,r,n),n>0.
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d),d>0.