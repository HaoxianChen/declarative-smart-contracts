mint(p,n) :- recv_mint(p,n),owner(o),msgSender(s),o==s.
controllerRedeem(p,n) :- recv_controllerRedeem(p,n),controller(c),p==c.
transfer(s,r,n) :- recv_transfer(s,r,n),controller(controller_p_1),n>0,s==controller_p_1.
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d).
controllerTransfer(s,r,n) :- recv_controllerTransfer(s,r,n).
burn(p,n) :- msgSender(s),owner(owner_x),o==s,owner(o),msgSender(msgSender_x),owner_x==msgSender_x,recv_burn(p,n).
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n),n>=0.