increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d),d>=0.
mint(p,n) :- cap(c_1),o_0==s_0,msgSender(s_0),recv_mint(p,n),owner(o_0),totalSupply(s_1),n+s_1<=c_1,n>=0.
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n),allowance(o,s,allowance_x2),n>0,n<allowance_x2.
transfer(s,r,n) :- recv_transfer(s,r,n),balanceOf(s,balanceOf_x1),n>0,n<=balanceOf_x1.