operatorBurn(p,s,n,data,operatorData) :- recv_operatorBurn(p,s,n,data,operatorData).
transferFrom(o,r,sp,n) :- n>0,recv_transferFrom(o,r,sp,n),balanceOf(o,balanceOf_x1_2),n<=allowance_x2_1,allowance(o,sp,allowance_x2_1),n<balanceOf_x1_2.
approveOperator(p,o) :- recv_approveOperator(p,o).
transfer(s,r,n) :- recv_transfer(s,r,n),balanceOf(s,balanceOf_x1_1),n>0,n<=balanceOf_x1_1.
operatorSend(o,r,s,n,data,operatorData) :- recv_operatorSend(o,r,s,n,data,operatorData).
revokeDefaultOperator(p,o) :- recv_revokeDefaultOperator(p,o).
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d),d>0.
burn(p,n) :- msgSender(s),n<=balanceOf_x1,balanceOf(p,balanceOf_x1),o==s,owner(o),recv_burn(p,n).
mint(p,n) :- msgSender(s),n>0,recv_mint(p,n),o==s,owner(o).