redeemByPartition(p,q,n) :- owner(o_2),n>0,balanceOfByPartition(p,q,b_1),recv_redeemByPartition(p,q,n),n<=b_1,msgSender(s_2),o_2==s_2.
transferByPartition(s,r,q,n) :- balanceOfByPartition(s,q,b_1),s==m_2,n<=b_1,recv_transferByPartition(s,r,q,n),msgSender(m_2),n>0.
issueByPartition(p,q,n) :- o_1==s_1,n>0,recv_issueByPartition(p,q,n),msgSender(s_1),owner(o_1).