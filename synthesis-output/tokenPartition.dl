issueByPartition(p,q,n) :- o_1==s_1,n>0,recv_issueByPartition(p,q,n),p!=address(0),msgSender(s_1),owner(o_1).
transferByPartition(s,r,q,n) :- n>0,s!=address(0),balanceOfByPartition(s,q,m_1),r!=address(0),n<=m_1,recv_transferByPartition(s,r,q,n).
redeemByPartition(p,q,n) :- o_1==s_1,n>0,n<=m_2,recv_redeemByPartition(p,q,n),p!=address(0),msgSender(s_1),balanceOfByPartition(p,q,m_2),owner(o_1).