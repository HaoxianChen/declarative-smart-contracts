redeemByPartition(p,q,n) :- msgSender(s),recv_redeemByPartition(p,q,n),owner(o),balanceOfByPartition(p,q,balanceOfByPartition_x2),s==o,n<=balanceOfByPartition_x2.
issueByPartition(p,q,n) :- msgSender(s),n>0,recv_issueByPartition(p,q,n),owner(o),s==o.
transferByPartition(s,r,q,n) :- recv_transferByPartition(s,r,q,n),balanceOfByPartition(s,q,balanceOfByPartition_x2_1),n>0,n<balanceOfByPartition_x2_1.