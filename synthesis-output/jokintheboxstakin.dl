unstake(p,stakeId,day) :- msgSender(p),onceUnstake(p,stakeId,false),stakeStakedDay(p,stakeId,staked),stakeStatus(p,stakeId,false),now(day),stakeLockPeriod(p,stakeId,lock),now(t),day>staked+lock,t>staked+lock,recv_unstake(stakeId).
stake(p,stakeId,amount,lockPeriod,day) :- recv_stake(stakeId,amount,lockPeriod),amount>0,msgSender(p),isValidLockPeriod(lockPeriod,ok_1),now(day),ok_1!=false.
withdraw(sender,total) :- maxPercentage(maxPct_2),inETH==true,thisBalance(bal_0),recv_withdraw(earnings,affiliateEarnings,inETH,messageHash,v,r,s),msgSender(sender_1),hundred(c_2),msgSender(sender),jokTokenBalance(tokenBal_2),total*c_0<bal_0*maxPct_0,hundred(c_0),total := earnings+affiliateEarnings,total*c_2<tokenBal_2*maxPct_2,maxPercentage(maxPct_0),valid_1!=false,isValidSignature(sender_1,total,inETH,messageHash,v,r,s,valid_1).