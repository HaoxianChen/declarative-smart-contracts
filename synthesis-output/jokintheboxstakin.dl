withdraw(sender,total) :- recv_withdraw(earnings,affiliateEarnings,inETH,messageHash,v,r,s),msgSender(sender),total := earnings+affiliateEarnings.
stake(p,stakeId,amount,lockPeriod,day) :- recv_stake(stakeId,amount,lockPeriod),msgSender(p),now(day),0!=stakeId.
unstake(p,stakeId,day) :- msgSender(p),onceUnstake(p,stakeId,false),stakeStakedDay(p,stakeId,staked),stakeStatus(p,stakeId,false),now(day),day>staked+lock,stakeLockPeriod(p,stakeId,lock),recv_unstake(stakeId).