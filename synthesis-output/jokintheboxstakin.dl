withdraw(sender,total) :- maxPercentage(maxPct_2),maxPercentage(maxPercentage_value_0),thisBalance(bal_0),recv_withdraw(earnings,affiliateEarnings,inETH,messageHash,v,r,s),stakeStakedDay_x2_1<msgValue,msgSender(sender),jokTokenBalance(tokenBal_2),hundred(c_0),total := earnings+affiliateEarnings,msgSender(msgSender),msgValue(msgValue),msgSender(sender_1),hundred(c_2),stakeStakedDay(msgSender,earnings,stakeStakedDay_x2_1),total*c_2<tokenBal_2*maxPct_2,maxPercentage(maxPct_0),total*c_0<bal_0*maxPct_0,maxPercentage_value_0>=msgValue,valid_1!=false,isValidSignature(sender_1,total,inETH,messageHash,v,r,s,valid_1).
unstake(p,stakeId,day) :- msgSender(p),onceUnstake(p,stakeId,false),stakeStakedDay(p,stakeId,staked),stakeStatus(p,stakeId,false),now(day),stakeLockPeriod(p,stakeId,lock),now(t),day>staked+lock,t>staked+lock,recv_unstake(stakeId).
