[ltcSwapAsset.dl] SeededPredicatesFromTxProperties: Map(burn(p,n) :- recv_burn(p,n). -> Set(Predicate(context: tx: recv_burn(_,_), bindings: [owner(o), msgSender(s)], functor: s==o)), swapOwnerTx(p,q,d) :- recv_swapOwnerTx(p,q,d). -> Set(Predicate(context: tx: recv_swapOwnerTx(p,_,_), bindings: [owner(current)], functor: p==current)), mint(p,n) :- recv_mint(p,n). -> Set(Predicate(context: tx: recv_mint(_,_), bindings: [owner(o), msgSender(s)], functor: s==o)))
[ltcSwapAsset.dl] InitialTransactionRules:
mint(p,n) :- recv_mint(p,n),owner(o),msgSender(s),s==o.
swapOwnerTx(p,q,d) :- recv_swapOwnerTx(p,q,d),owner(current),p==current.
burn(p,n) :- recv_burn(p,n),owner(o),msgSender(s),s==o.
transfer(s,r,n) :- recv_transfer(s,r,n).
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d).
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n).
