[erc1155.dl] SeededPredicatesFromTxProperties: Map(burn(t,p,n) :- recv_burn(t,p,n). -> Set(Predicate(context: tx: recv_burn(_,_,_), bindings: [owner(o), msgSender(s)], functor: o==s)), mint(t,p,n) :- recv_mint(t,p,n). -> Set(Predicate(context: tx: recv_mint(_,_,_), bindings: [owner(o), msgSender(s)], functor: o==s)))
[erc1155.dl] InitialTransactionRules:
burn(t,p,n) :- recv_burn(t,p,n),owner(o),msgSender(s),o==s.
transferFrom(t,o,r,sp,n) :- recv_transferFrom(t,o,r,sp,n).
mint(t,p,n) :- recv_mint(t,p,n),owner(o),msgSender(s),o==s.
increaseAllowance(t,o,s,d) :- recv_increaseAllowance(t,o,s,d).
transfer(t,s,r,n) :- recv_transfer(t,s,r,n).
