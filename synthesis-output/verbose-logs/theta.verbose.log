[theta.dl] SeededPredicatesFromTxProperties: Map(disallowPrecirculation(p) :- recv_disallowPrecirculation(p). -> Set(Predicate(context: tx: recv_disallowPrecirculation(_), bindings: [owner(o), msgSender(s)], functor: s==o)), allowPrecirculation(p) :- recv_allowPrecirculation(p). -> Set(Predicate(context: tx: recv_allowPrecirculation(_), bindings: [owner(o), msgSender(s)], functor: s==o)))
[theta.dl] InitialTransactionRules:
disallowPrecirculation(p) :- recv_disallowPrecirculation(p),owner(o),msgSender(s),s==o.
allowPrecirculation(p) :- recv_allowPrecirculation(p),owner(o),msgSender(s),s==o.
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d).
transfer(s,r,n) :- recv_transfer(s,r,n).
mint(p,n) :- recv_mint(p,n).
burn(p,n) :- recv_burn(p,n).
transferFrom(o,r,sp,n) :- recv_transferFrom(o,r,sp,n).
