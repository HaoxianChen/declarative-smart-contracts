refund(p,n) :- recv_refund(p,n).
withdraw(p,r) :- recv_withdraw(p,r),beneficiary(b),p==b.
close() :- recv_close(),owner(o),msgSender(s),s==o.
invest(p,n) :- recv_invest(p,n).
