[Audit] BenchmarkStart: name=shib.dl, benchDir=synthesis-benchmark/shib
[Audit] InputSpecFiles: schema=synthesis-benchmark/shib/schema.dl, rules=synthesis-benchmark/shib/rules.dl, properties=synthesis-benchmark/shib/properties.dl
[Audit] ForbidConfig: global=<none>, perBenchmark=<none>
[Audit] LeakageCheck: synthesizer consumes specification + BMC counterexamples only; it does not load synthesized outputs as supervision labels.
[Audit] OutputTargets: datalogOut=synthesis-output/shib.dl, stats=synthesis-output/synthesis_stats.csv
[shib.dl] BenchmarkStart: program=Shib, maxBound=5, maxIters=120, maxSolutionsPerStep=20
[shib.dl] SeededPredicatesFromTxProperties: Map(mint(p,n) :- recv_mint(p,n). -> Set(Predicate(context: tx: recv_mint(_,_), bindings: [owner(o), msgSender(s)], functor: s==o)), burn(p,n) :- recv_burn(p,n). -> Set(Predicate(context: tx: recv_burn(_,_), bindings: [owner(o), msgSender(s)], functor: s==o)))
[shib.dl] InitialTransactionRules:
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d).
burn(p,n) :- recv_burn(p,n),owner(o),msgSender(s),s==o.
mint(p,n) :- recv_mint(p,n),owner(o),msgSender(s),s==o.
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n).
burnFrom(s,p,n) :- recv_burnFrom(s,p,n).
transfer(s,r,n) :- recv_transfer(s,r,n).
