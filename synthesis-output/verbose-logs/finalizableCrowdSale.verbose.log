[finalizableCrowdSale.dl] InitialTransactionRules:
mint(p,n) :- recv_mint(p,n),owner(o),msgSender(s),o==s.
burn(p,n) :- recv_burn(p,n),owner(o),msgSender(s),o==s.
transfer(s,r,n) :- recv_transfer(s,r,n).
finalize() :- recv_finalize(),owner(o),msgSender(s),o==s.
buyToken(p,m) :- recv_buyToken(p,m).
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d).
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n).
