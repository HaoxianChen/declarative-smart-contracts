[brickBlockToken.dl] InitialTransactionRules:
decreaseAllowance(o,s,d) :- recv_decreaseAllowance(o,s,d).
unpause() :- recv_unpause(),owner(o),msgSender(s),s==o.
pause() :- recv_pause(),owner(o),msgSender(s),s==o.
transfer(s,r,n) :- recv_transfer(s,r,n).
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d).
upgrade(p) :- recv_upgrade(p),owner(o),msgSender(s),s==o.
mint(p,n) :- recv_mint(p,n),owner(o),msgSender(s),s==o.
transferFrom(s,f,r,n) :- recv_transferFrom(s,f,r,n).
evacuate(p) :- recv_evacuate(p),owner(o),msgSender(s),s==o.
