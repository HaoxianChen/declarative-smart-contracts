[tether.dl] BenchmarkStart: program=Tether, maxBound=5, maxIters=120, maxSolutionsPerStep=20
[tether.dl] SeededPredicatesFromTxProperties: Map(issue(p,n) :- recv_issue(p,n). -> Set(Predicate(context: tx: recv_issue(_,_), bindings: [owner(o), msgSender(s)], functor: s==o)), destroyBlackFund(p,n) :- recv_destroyBlackFund(p,n). -> Set(Predicate(context: tx: recv_destroyBlackFund(_,_), bindings: [owner(o), msgSender(s)], functor: s==o)), addBlackList(p) :- recv_addBlackList(p). -> Set(Predicate(context: tx: recv_addBlackList(_), bindings: [owner(o), msgSender(s)], functor: o==s)), redeem(p,n) :- recv_redeem(p,n). -> Set(Predicate(context: tx: recv_redeem(_,_), bindings: [owner(o), msgSender(s)], functor: s==o)))
[tether.dl] InitialTransactionRules:
addBlackList(p) :- recv_addBlackList(p),owner(o),msgSender(s),o==s.
transfer(s,r,n) :- recv_transfer(s,r,n).
redeem(p,n) :- recv_redeem(p,n),owner(o),msgSender(s),s==o.
issue(p,n) :- recv_issue(p,n),owner(o),msgSender(s),s==o.
destroyBlackFund(p,n) :- recv_destroyBlackFund(p,n),owner(o),msgSender(s),s==o.
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d).
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n).
