[crowdsale2.dl] SeededPredicatesFromTxProperties: Map(transferPrimary(p) :- recv_transferPrimary(p). -> Set(Predicate(context: tx: recv_transferPrimary(_), bindings: [_primary(p), msgSender(s)], functor: s==p)), finalize() :- recv_finalize(). -> Set(Predicate(context: tx: recv_finalize(), bindings: [_primary(p), msgSender(s)], functor: s==p)))
[crowdsale2.dl] InitialTransactionRules:
transferPrimary(p) :- recv_transferPrimary(p),_primary(p),msgSender(s),s==p.
finalize() :- recv_finalize(),_primary(p),msgSender(s),s==p.
transfer(s,r,n) :- recv_transfer(s,r,n).
mint(p,n) :- recv_mint(p,n).
claimRefund(p) :- recv_claimRefund(p).
withdraw(p) :- recv_withdraw(p).
buyToken(p,v) :- recv_buyToken(p,v).
deposit(p,a) :- recv_deposit(p,a).
increaseAllowance(o,s,d) :- recv_increaseAllowance(o,s,d).
burn(p,n) :- recv_burn(p,n).
transferFrom(o,r,sp,n) :- recv_transferFrom(o,r,sp,n).
