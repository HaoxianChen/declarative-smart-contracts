[Audit] BenchmarkStart: name=matic.dl, benchDir=synthesis-benchmark/matic
[Audit] InputSpecFiles: schema=synthesis-benchmark/matic/schema.dl, rules=synthesis-benchmark/matic/rules.dl, properties=synthesis-benchmark/matic/properties.dl
[Audit] ForbidConfig: global=<none>, perBenchmark=synthesis-benchmark/matic/forbid.json
[Audit] LeakageCheck: synthesizer consumes specification + BMC counterexamples only; it does not load synthesized outputs as supervision labels.
[Audit] OutputTargets: datalogOut=synthesis-output/matic.dl, stats=synthesis-output/synthesis_stats.csv
[matic.dl] BenchmarkStart: program=Matic, maxBound=5, maxIters=120, maxSolutionsPerStep=20
[matic.dl] SeededPredicatesFromTxProperties: Map(mint(p,n) :- recv_mint(p,n). -> Set(Predicate(context: tx: recv_mint(_,_), bindings: [owner(o), msgSender(s)], functor: s==o)), unpause() :- recv_unpause(). -> Set(Predicate(context: tx: recv_unpause(), bindings: [owner(p), msgSender(s)], functor: s==p)), burn(p,n) :- recv_burn(p,n). -> Set(Predicate(context: tx: recv_burn(_,_), bindings: [owner(o), msgSender(s)], functor: s==o)), pause() :- recv_pause(). -> Set(Predicate(context: tx: recv_pause(), bindings: [owner(p), msgSender(s)], functor: s==p)))
[matic.dl] InitialTransactionRules:
pause() :- recv_pause(),owner(p),msgSender(s),s==p.
unpause() :- recv_unpause(),owner(p),msgSender(s),s==p.
decreaseAllowance(o,s,n) :- recv_decreaseAllowance(o,s,n).
burn(p,n) :- recv_burn(p,n),owner(o),msgSender(s),s==o.
mint(p,n) :- recv_mint(p,n),owner(o),msgSender(s),s==o.
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n).
increaseAllowance(o,s,n) :- recv_increaseAllowance(o,s,n).
transfer(s,r,n) :- recv_transfer(s,r,n).
