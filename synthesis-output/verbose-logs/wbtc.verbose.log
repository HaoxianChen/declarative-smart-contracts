[wbtc.dl] SeededPredicatesFromTxProperties: HashMap(claimOwnership(p) :- recv_claimOwnership(p). -> Set(Predicate(context: tx: recv_claimOwnership(p), bindings: [pendingOwner(expected)], functor: p==expected), Predicate(context: tx: recv_claimOwnership(_), bindings: [pendingOwner(expected), msgSender(s)], functor: s==expected)), mint(p,n) :- recv_mint(p,n). -> Set(Predicate(context: tx: recv_mint(_,_), bindings: [owner(o), msgSender(s)], functor: s==o)), transferOwnership(p) :- recv_transferOwnership(p). -> Set(Predicate(context: tx: recv_transferOwnership(_), bindings: [owner(o), msgSender(s)], functor: s==o)), paused(false) :- recv_unpause(). -> Set(Predicate(context: tx: recv_unpause(), bindings: [owner(o), msgSender(s)], functor: s==o)), paused(true) :- recv_pause(). -> Set(Predicate(context: tx: recv_pause(), bindings: [owner(o), msgSender(s)], functor: s==o)))
[wbtc.dl] InitialTransactionRules:
claimOwnership(p) :- recv_claimOwnership(p),pendingOwner(expected_0),pendingOwner(expected_1),s_0==expected_0,p==expected_1,msgSender(s_0).
paused(true) :- recv_pause(),owner(o),msgSender(s),s==o.
mint(p,n) :- recv_mint(p,n),owner(o),msgSender(s),s==o.
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n).
burn(p,n) :- recv_burn(p,n).
decreaseApproval(o,s,n) :- recv_decreaseApproval(o,s,n).
paused(false) :- recv_unpause(),owner(o),msgSender(s),s==o.
transferOwnership(p) :- recv_transferOwnership(p),owner(o),msgSender(s),s==o.
increaseApproval(o,s,n) :- recv_increaseApproval(o,s,n).
transfer(s,r,n) :- recv_transfer(s,r,n).
