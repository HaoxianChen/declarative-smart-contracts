burn(p,n) :- msgSender(s),n<=balanceOf_x1,balanceOf(p,balanceOf_x1),owner(o),s==o,recv_burn(p,n).
unpause() :- recv_unpause(),owner(p),msgSender(s),s==p.
transferFrom(o,r,s,n) :- recv_transferFrom(o,r,s,n),allowance(o,s,allowance_x2),n<=allowance_x2.
decreaseAllowance(o,s,n) :- recv_decreaseAllowance(o,s,n),owner_x_0==msgSender_x_0,balanceOf(o,balanceOf_x1_1),msgSender(msgSender_x_0),n<=balanceOf_x1_1,owner(owner_x_0).
mint(p,n) :- msgSender(s),n>0,recv_mint(p,n),owner(o),s==o.
transfer(s,r,n) :- recv_transfer(s,r,n).
pause() :- recv_pause(),owner(p),msgSender(s),s==p.
increaseAllowance(o,s,n) :- recv_increaseAllowance(o,s,n),n>0.